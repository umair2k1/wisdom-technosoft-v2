---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Resource Not Found // Wisdom Technosoft"
  description="Requested route does not exist on cluster. Return to Wisdom Technosoft root specification."
  noindex={true}
>
  <div class="blueprint-shell error-page" data-theme="paper">
    <header class="error-head border-b">
      <a class="brand font-mono" href="/" aria-label="Wisdom Technosoft Root">
        <img src="/assets/logo-mark.png" alt="Wisdom Technosoft" width="34" height="28" />
        <span>WISDOM TECHNOSOFT</span>
      </a>
      <a class="btn-industrial btn-outline-paper font-mono" href="/">&larr; RETURN TO ROOT</a>
    </header>

    <div class="section-meta-bar">
      <div class="meta-left">
        <span class="meta-index">[STATUS // 404]</span>
        <span class="meta-tag">ROUTING EXCEPTION &bull; RESOURCE NOT LOCATED</span>
      </div>
      <div class="meta-right">
        <span class="meta-annotation font-mono">TRACE: ADDRESS_UNRESOLVED</span>
      </div>
    </div>

    <main id="main" tabindex="-1" class="error-content">
      <div class="error-box">
        <span class="tech-tag tech-tag-signal font-mono">NULL ROUTE</span>
        <h1 class="error-title">Requested route does not exist on cluster.</h1>
        <p class="error-desc">
          The requested path was either deprecated, re-indexed, or entered with an invalid URI parameter. The production system is operating normally.
        </p>

        <div class="error-actions">
          <a class="btn-industrial btn-signal" href="/">GO TO ROOT SPECIFICATION</a>
        </div>

        <div class="routes-block font-mono">
          <span class="routes-title">[AVAILABLE SYSTEM ROUTES]</span>
          <ul class="routes-list">
            <li><a href="/#services"><span class="r-idx">[01]</span> Capabilities &mdash; Software, Voice, Data, RCM</a></li>
            <li><a href="/#approach"><span class="r-idx">[02]</span> Disciplines &mdash; Operating Contract &amp; SLAs</a></li>
            <li><a href="/#vision"><span class="r-idx">[03]</span> Spec &mdash; System Manifesto &amp; Values</a></li>
            <li><a href="/#team"><span class="r-idx">[04]</span> Division &mdash; Leadership &amp; Governance</a></li>
            <li><a href="/#contact"><span class="r-idx">[05]</span> Transmit &mdash; Direct Project Inquiry</a></li>
          </ul>
        </div>
      </div>
    </main>

    <footer class="error-footer border-t font-mono">
      <span>WISDOM TECHNOSOFT &bull; NAGPUR CORE</span>
      <span>DISPATCH: <a href="mailto:wisdomtechnosoft04@gmail.com">wisdomtechnosoft04@gmail.com</a> &bull; <a href="tel:+917447331127">+91 74473 31127</a></span>
    </footer>
  </div>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-paper);
    color: var(--text-primary);
  }

  .error-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--grid-pad);
    background: var(--bg-paper);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    color: var(--text-primary);
  }

  .error-content {
    flex: 1;
    padding: clamp(48px, 8vw, 96px) var(--grid-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .error-box {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .error-title {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .error-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .error-actions {
    margin-top: 8px;
  }

  .routes-block {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-paper);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .routes-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.08em;
  }

  .routes-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 12px;
  }

  .routes-list a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .routes-list a:hover {
    color: var(--accent-signal);
  }

  .r-idx {
    color: var(--accent-signal);
    font-weight: 700;
  }

  .error-footer {
    padding: 16px var(--grid-pad);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
    color: var(--text-muted);
    background: var(--bg-surface);
  }

  .error-footer a {
    color: var(--text-primary);
    text-decoration: none;
  }
</style>
