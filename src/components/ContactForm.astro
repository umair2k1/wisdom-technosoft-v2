---
// Wisdom Technosoft — Contact Component
// Preserved backend endpoint (/api/contact) & submission logic
// Daylight Drafting Paper Theme • Architectural Swiss Grid Form Panel
---

<section class="contact-section s" id="contact" data-theme-trigger="daylight">
  <div class="w contact-container">
    
    <!-- Header -->
    <div class="contact-header">
      <div class="eyebrow-row">
        <span class="eyebrow">DIRECT ENGAGEMENT &bull; CONTRACT SCOPING</span>
        <span class="blueprint-tag active"><span class="tag-dot"></span> SLA: 1 BUSINESS DAY</span>
      </div>

      <div class="header-split">
        <h2 class="sec-title">
          Let&rsquo;s build something <br />
          <span class="text-orange">worth keeping.</span>
        </h2>
        <p class="sec-subtitle">
          Whether you need custom software engineering, a dedicated telecalling squad, or high-accuracy data and medical billing support &mdash; our team is ready to scale with you.
        </p>
      </div>
    </div>

    <!-- Contact Layout: Left Channels & Right Architectural Form -->
    <div class="contact-layout">
      
      <!-- Left Channels Panel -->
      <div class="contact-channels-panel grid-frame">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="channels-top">
          <span class="channel-code">COMM // DIRECT</span>
          <span class="status-pill">FAST ROUTE</span>
        </div>

        <h3 class="channels-heading">Direct Inquiries &amp; Delivery Hub</h3>
        <p class="channels-lead">
          Reach our engineering principals and delivery leads directly through phone, encrypted messaging, or email.
        </p>

        <div class="methods-stack">
          <div class="method-box">
            <span class="m-label">Direct Line / Telephony</span>
            <a href="tel:+917447331127" class="m-val">+91 74473 31127</a>
          </div>

          <div class="method-box">
            <span class="m-label">Official Email</span>
            <a href="mailto:wisdomtechnosoft04@gmail.com" class="m-val">wisdomtechnosoft04@gmail.com</a>
          </div>

          <div class="method-box">
            <span class="m-label">Nagpur Operational Hub</span>
            <address class="m-val m-addr">
              Opposite Bank of Baroda, Ward Number 3, Parsodi, Trimurtee Nagar, Nagpur &ndash; 440022, Maharashtra, India
            </address>
          </div>
        </div>

        <div class="channel-action-row">
          <a class="btn btn-secondary btn-sm whatsapp-btn" href="https://wa.me/917447331127?text=Hello%20Wisdom%20Technosoft%2C%20I%20would%20like%20to%20inquire%20about%20your%20services." target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.654-1.9-.173-.139-.371-.223-.594-.223-.223 0-.446.074-.644.223-.198.149-.768.743-1.041 1.016-.272.272-.446.347-.743.198-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.654-1.9-.173-.139-.371-.223-.594-.223-.223 0-.446.074-.644.223z"/></svg>
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Right Form Panel -->
      <div class="contact-form-panel grid-frame">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <form class="inquiry-form" id="cform" action="/api/contact" method="POST">
          <div class="form-header">
            <span class="f-code">SPEC // FORM_INQUIRY</span>
            <span class="f-note">All fields handled strictly under NDA</span>
          </div>

          <!-- Honeypot -->
          <div class="hp" aria-hidden="true" style="display:none;">
            <label for="f-web">Leave this empty</label>
            <input id="f-web" name="website_url" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-grid">
            <div class="form-field">
              <label for="f-name">Your Name <span class="req">*</span></label>
              <input id="f-name" name="name" required autocomplete="name" placeholder="e.g. Aarav Sharma" />
            </div>

            <div class="form-field">
              <label for="f-email">Work Email <span class="req">*</span></label>
              <input id="f-email" type="email" name="email" required autocomplete="email" placeholder="e.g. aarav@company.com" />
            </div>

            <div class="form-field">
              <label for="f-phone">Phone / WhatsApp</label>
              <input id="f-phone" type="tel" name="phone" autocomplete="tel" placeholder="+91 98765 43210" />
            </div>

            <div class="form-field">
              <label for="f-service">Interested Capability</label>
              <div class="select-wrap">
                <select id="f-service" name="service">
                  <option value="Software Development">Software Development</option>
                  <option value="Telecalling Services">Telecalling Services</option>
                  <option value="Data Entry & Management">Data Entry &amp; Management</option>
                  <option value="Business Process & Industrial Solutions">Business Process &amp; Industrial Solutions</option>
                  <option value="Healthcare Support / US Medical Billing">Healthcare Support / US Medical Billing</option>
                  <option value="General Inquiry">General Inquiry</option>
                </select>
              </div>
            </div>
          </div>

          <div class="form-field full">
            <label for="f-message">Project Overview &amp; Requirements <span class="req">*</span></label>
            <textarea id="f-message" name="message" rows="4" required placeholder="Describe your technical scope, volume of records, or operational timelines..."></textarea>
          </div>

          <div class="form-submit-row">
            <button class="btn btn-primary" type="submit" id="send">
              <span>Send Inquiry</span>
              <span>&rarr;</span>
            </button>
            <span class="privacy-note">Zero marketing spam. We respond within 1 business day.</span>
          </div>

          <p class="status-msg" id="status" role="status" aria-live="polite"></p>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  // Form submission handler preserving API endpoint & behavior
  const form = document.getElementById("cform") as HTMLFormElement | null;
  const send = document.getElementById("send") as HTMLButtonElement | null;
  const status = document.getElementById("status") as HTMLElement | null;

  if (form && send && status) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (data.website_url) {
        status.className = "status-msg ok";
        status.textContent = "Thank you. We have received your inquiry.";
        form.reset();
        return;
      }

      const originalHtml = send.innerHTML;
      send.disabled = true;
      send.innerHTML = '<span>Transmitting…</span>';
      status.className = "status-msg";
      status.textContent = "";

      try {
        const res = await fetch(form.getAttribute("action") || "/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify(data)
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json.message || "Failed to submit inquiry");

        status.className = "status-msg ok";
        status.textContent = "Thank you! We have received your message and our team will be in touch shortly.";
        form.reset();
      } catch (err: any) {
        status.className = "status-msg err";
        status.innerHTML = `Could not send inquiry online. Please email directly to <a href="mailto:wisdomtechnosoft04@gmail.com" class="lnk">wisdomtechnosoft04@gmail.com</a> or call <a href="tel:+917447331127" class="lnk">+91 74473 31127</a>.`;
      } finally {
        send.disabled = false;
        send.innerHTML = originalHtml;
      }
    });
  }

  // Pre-select service from external cards
  document.querySelectorAll<HTMLAnchorElement>("[data-service-select]").forEach(btn => {
    btn.addEventListener("click", () => {
      const serviceName = btn.getAttribute("data-service-select");
      const selectEl = document.getElementById("f-service") as HTMLSelectElement | null;
      if (selectEl && serviceName) {
        for (let i = 0; i < selectEl.options.length; i++) {
          if (selectEl.options[i].value === serviceName) {
            selectEl.selectedIndex = i;
            break;
          }
        }
      }
    });
  });
</script>

<style>
  .contact-section {
    position: relative;
    padding-block: clamp(80px, 12vh, 140px);
    background-color: var(--bg);
    color: var(--ink);
    border-bottom: 1px solid var(--border);
  }

  .contact-header {
    margin-bottom: 48px;
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .header-split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 32px;
    align-items: flex-end;
  }

  .text-orange {
    color: var(--accent);
  }

  /* Contact Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
  }

  /* Left Channels Panel */
  .contact-channels-panel {
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .channels-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    font-family: var(--mono);
    font-size: 10px;
  }

  .channel-code {
    color: var(--accent);
    font-weight: 700;
  }

  .status-pill {
    padding: 2px 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--ink-muted);
  }

  .channels-heading {
    font-family: var(--disp);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .channels-lead {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: 28px;
  }

  .methods-stack {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 32px;
  }

  .method-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--mono);
  }

  .m-label {
    font-size: 10px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .m-val {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.5;
  }

  .m-val:hover {
    color: var(--accent);
  }

  .m-addr {
    font-style: normal;
    font-family: var(--body);
    font-size: 13.5px;
    font-weight: 400;
    color: var(--ink-muted);
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Right Form Panel */
  .contact-form-panel {
    padding: 36px;
  }

  .form-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
    font-family: var(--mono);
    font-size: 10px;
  }

  .f-code {
    color: var(--accent);
    font-weight: 700;
  }

  .f-note {
    color: var(--ink-muted);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field.full {
    margin-bottom: 24px;
  }

  .form-field label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .req {
    color: var(--accent);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 12px 14px;
    border-radius: 0;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--accent);
    background: var(--surface-card);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap select {
    width: 100%;
    appearance: none;
    cursor: pointer;
  }

  .form-submit-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .privacy-note {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-muted);
  }

  .status-msg {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 12px;
    padding: 10px 14px;
    display: none;
  }

  .status-msg.ok {
    display: block;
    background: rgba(0, 200, 83, 0.1);
    border: 1px solid rgba(0, 200, 83, 0.3);
    color: #00873D;
  }

  .status-msg.err {
    display: block;
    background: rgba(255, 59, 0, 0.1);
    border: 1px solid rgba(255, 59, 0, 0.3);
    color: #D93200;
  }

  @media (max-width: 900px) {
    .header-split {
      grid-template-columns: 1fr;
    }
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
    .form-submit-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
