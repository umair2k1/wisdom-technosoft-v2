<section class="s contact-section" id="contact" style="--bg:var(--teal);--fg:var(--ivory)">
  <div class="w contact-container">
    <!-- Section 2: Contact Layout & Form -->
    <div class="contact-header">
      <p class="eyebrow" data-scramble="Get in Touch • Direct Partnership">Get in Touch &bull; Direct Partnership</p>
      <h2 class="contact-title" data-scramble="Let's build something worth keeping.">Let&rsquo;s build something worth keeping.</h2>
      <p class="contact-subtitle">
        Whether you require custom software engineering, an outbound voice campaign, or accurate data and medical billing support, our team is ready to scale with you.
      </p>
    </div>

    <div class="contact-layout">
      <!-- Left: Contact Details & Channels -->
      <div class="contact-info-panel tilt-card">
        <div class="sla-badge">
          <span class="sla-dot"></span>
          <span>We respond within 1 business day</span>
        </div>

        <div class="contact-methods">
          <div class="method-card">
            <span class="method-label">Direct Email</span>
            <a class="method-val method-email" href="mailto:wisdomtechnosoft04@gmail.com">wisdomtechnosoft04@gmail.com</a>
          </div>

          <div class="method-card">
            <span class="method-label">Direct Call</span>
            <a class="method-val" href="tel:+917447331127">+91 74473 31127</a>
          </div>

          <div class="method-card">
            <span class="method-label">Delivery Hub Address</span>
            <a class="method-val method-addr" href="https://maps.google.com/?q=Opposite+Bank+of+Baroda,+Ward+Number+3,+Parsodi,+Trimurtee+Nagar,+Nagpur,+Maharashtra+440022" target="_blank" rel="noopener">
              Opposite Bank of Baroda, Ward Number 3, Parsodi, Trimurtee Nagar, Nagpur &ndash; 440022, Maharashtra, India
            </a>
          </div>
        </div>

        <div class="contact-actions-box">
          <a class="btn btn-whatsapp magnetic" href="https://wa.me/917447331127?text=Hello%20Wisdom%20Technosoft%2C%20I%20would%20like%20to%20inquire%20about%20your%20services." target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.654-1.934-.173-.173-.371-.248-.594-.248s-.446.074-.644.272l-1.04 1.262c-.149.173-.297.198-.57.074-.272-.124-1.164-.429-2.217-1.368-.818-.73-1.369-1.632-1.53-1.905-.16-.272-.017-.42.12-.556.124-.124.272-.322.408-.483.136-.16.182-.272.272-.446.09-.173.045-.347-.023-.495-.068-.149-.644-1.551-.883-2.125-.233-.559-.47-.483-.644-.492l-.545-.01c-.186 0-.495.068-.755.347s-.99 0.967-.99 2.359 1.015 2.73 1.157 2.923c.142.193 1.999 3.052 4.842 4.28 2.843 1.228 2.843.818 3.363.768.52-.05 1.676-.684 1.912-1.345.235-.661.235-1.228.165-1.345z"/></svg>
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Right: Structured Form -->
      <div class="contact-form-panel tilt-card">
        <form class="inquiry-form" id="cform" action="/api/contact" method="POST">
          <div class="form-intro">
            <h3 class="form-title">Send an inquiry</h3>
            <p class="form-hint">Tell us about your project or requirements. We respect your confidentiality.</p>
          </div>

          <!-- Honeypot -->
          <div class="hp" aria-hidden="true">
            <label for="f-web">Leave this empty</label>
            <input id="f-web" name="website_url" tabindex="-1" autocomplete="off">
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="f-name">Your Name <span class="req">*</span></label>
              <input id="f-name" name="name" required autocomplete="name" autocapitalize="words" placeholder="e.g. Aarav Sharma">
            </div>
            <div class="form-field">
              <label for="f-email">Email Address <span class="req">*</span></label>
              <input id="f-email" type="email" name="email" required autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="e.g. aarav@company.com">
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="f-phone">Phone / WhatsApp</label>
              <input id="f-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+91 98765 43210">
            </div>
            <div class="form-field">
              <label for="f-service">Interested Service</label>
              <div class="select-wrapper">
                <select id="f-service" name="service">
                  <option value="Software Development">Software Development</option>
                  <option value="Telecalling Services">Telecalling Services</option>
                  <option value="Data Entry & Management">Data Entry &amp; Management</option>
                  <option value="Business Process & Industrial Solutions">Business Process &amp; Industrial Solutions</option>
                  <option value="Healthcare Support / US Medical Billing">Healthcare Support / US Medical Billing</option>
                  <option value="General Inquiry">General Inquiry</option>
                </select>
              </div>
            </div>
          </div>

          <div class="form-field">
            <label for="f-message">Project Overview &amp; Goals <span class="req">*</span></label>
            <textarea id="f-message" name="message" rows="4" required autocapitalize="sentences" enterkeyhint="send" placeholder="Please describe your requirements, timeline, or expected deliverables..."></textarea>
          </div>

          <div class="form-submit-row">
            <button class="btn btn-submit magnetic" type="submit" id="send">
              <span>Send Inquiry</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
            <span class="privacy-note">Zero spam. Information is solely used to reply to your inquiry.</span>
          </div>

          <p class="status" id="status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>

  // 2. Contact form submit handler
  const form = document.getElementById("cform") as HTMLFormElement | null;
  const send = document.getElementById("send") as HTMLButtonElement | null;
  const status = document.getElementById("status") as HTMLElement | null;

  if (form && send && status) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (data.website_url) {
        status.className = "status ok";
        status.textContent = "Thank you. We have received your inquiry.";
        form.reset();
        return;
      }

      const originalText = send.innerHTML;
      send.disabled = true;
      send.innerHTML = '<span>Sending…</span>';
      status.className = "status";
      status.textContent = "";

      try {
        const res = await fetch(form.getAttribute("action") || "/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify(data)
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json.message || "Failed to submit");

        status.className = "status ok";
        status.textContent = "Thank you! We have received your message and will be in touch shortly.";
        form.reset();
      } catch {
        status.className = "status err";
        status.innerHTML = 'Could not send inquiry online. Please email directly to <a href="mailto:wisdomtechnosoft04@gmail.com">wisdomtechnosoft04@gmail.com</a> or call <a href="tel:+917447331127">+91 74473 31127</a>.';
      } finally {
        send.disabled = false;
        send.innerHTML = originalText;
      }
    });
  }
</script>

<style is:global>
  .contact-section {
    padding-block: clamp(70px, 11vh, 130px);
    background: var(--teal);
    position: relative;
    overflow: hidden;
  }
  .contact-container {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 7vh, 72px);
    position: relative;
    z-index: 2;
  }

  /* Contact Details & Form */
  .contact-header {
    max-width: 720px;
  }
  .contact-title {
    font: 800 clamp(2.2rem, 4.4vw, 3.8rem)/1.08 var(--disp);
    letter-spacing: -0.03em;
    color: var(--ivory);
    margin-top: 10px;
  }
  .contact-subtitle {
    max-width: 54ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ivory);
    opacity: 0.8;
    margin-top: 10px;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .contact-info-panel {
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: rgba(4, 34, 43, 0.65);
    border: 1px solid rgba(244, 240, 232, 0.1);
    border-radius: 20px;
    padding: clamp(24px, 4vw, 36px);
    backdrop-filter: blur(14px);
    position: relative;
    overflow: hidden;
  }
  .contact-info-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 300px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(201, 162, 126, 0.15), transparent 70%);
    pointer-events: none;
  }

  .sla-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(201, 162, 126, 0.12);
    border: 1px solid rgba(201, 162, 126, 0.25);
    color: var(--tan);
    font-size: 13px;
    font-weight: 600;
    width: fit-content;
  }
  .sla-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tan);
    box-shadow: 0 0 6px var(--tan);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    z-index: 2;
  }
  .method-card {
    background: rgba(6, 51, 64, 0.5);
    border: 1px solid rgba(244, 240, 232, 0.08);
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .method-card:hover {
    border-color: rgba(201, 162, 126, 0.35);
    background: rgba(6, 51, 64, 0.7);
  }
  .method-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tan);
  }
  .method-val {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ivory);
    text-decoration: none;
    line-height: 1.45;
    transition: color 0.2s ease;
  }
  .method-val:hover {
    color: var(--tan);
  }
  .method-email {
    font-size: 1.12rem;
    font-weight: 600;
  }
  .method-addr {
    font-size: 0.92rem;
    opacity: 0.85;
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #25d366;
    color: #04222B;
    font-weight: 600;
    font-size: 14.5px;
    padding: 14px 24px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.25);
    transition: transform 0.25s ease, background 0.25s ease;
    width: 100%;
  }
  .btn-whatsapp:hover {
    transform: translateY(-2px);
    background: #2ee06e;
  }

  /* Form panel */
  .contact-form-panel {
    background: rgba(4, 34, 43, 0.75);
    border: 1px solid rgba(244, 240, 232, 0.12);
    border-radius: 20px;
    padding: clamp(24px, 4vw, 40px);
    backdrop-filter: blur(16px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    position: relative;
    overflow: hidden;
  }
  .contact-form-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 350px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(201, 162, 126, 0.14), transparent 70%);
    pointer-events: none;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
    z-index: 2;
  }
  .form-intro {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(244, 240, 232, 0.08);
  }
  .form-title {
    font: 700 1.55rem/1.2 var(--disp);
    color: var(--ivory);
    letter-spacing: -0.02em;
  }
  .form-hint {
    font-size: 0.92rem;
    color: var(--ivory);
    opacity: 0.75;
  }

  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .form-field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--ivory);
    opacity: 0.9;
  }
  .req {
    color: var(--tan);
  }
  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 12px 16px;
    border-radius: 8px;
    background: rgba(244, 240, 232, 0.06);
    border: 1px solid rgba(244, 240, 232, 0.16);
    color: var(--ivory);
    font: 400 14px "DM Sans", sans-serif;
    outline: none;
    transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--tan);
    background: rgba(244, 240, 232, 0.1);
    box-shadow: 0 0 0 3px rgba(201, 162, 126, 0.25);
  }
  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: rgba(244, 240, 232, 0.4);
  }
  .select-wrapper {
    position: relative;
  }
  .select-wrapper select {
    cursor: pointer;
    appearance: none;
    padding-right: 36px;
  }
  .select-wrapper::after {
    content: "▾";
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--tan);
    pointer-events: none;
    font-size: 14px;
  }

  .form-submit-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .btn-submit {
    width: 100%;
    gap: 10px;
    background: var(--tan);
    color: var(--ink);
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 600;
    box-shadow: 0 4px 18px rgba(201, 162, 126, 0.25);
  }
  .btn-submit:hover {
    background: #d4b18f;
  }
  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .privacy-note {
    font-size: 12px;
    color: var(--ivory);
    opacity: 0.65;
    text-align: center;
  }

  .status {
    font-size: 14px;
    line-height: 1.5;
    padding: 12px 16px;
    border-radius: 8px;
    display: none;
  }
  .status.ok {
    display: block;
    background: rgba(46, 125, 50, 0.2);
    border: 1px solid rgba(76, 175, 80, 0.4);
    color: #a5d6a7;
  }
  .status.err {
    display: block;
    background: rgba(198, 40, 40, 0.2);
    border: 1px solid rgba(239, 83, 80, 0.4);
    color: #ef9a9a;
  }
  .status.err a {
    color: var(--ivory);
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .scoper-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-form-panel {
      padding: 20px 16px;
    }
    .output-metrics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
