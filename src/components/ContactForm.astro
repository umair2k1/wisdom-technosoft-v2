---

<section class="contact-section junction-marker" id="contact" data-theme="ink">
  <!-- Section Meta Bar -->
  <div class="section-meta-bar">
    <div class="meta-left">
      <span class="meta-index">[05 // TRANSMIT]</span>
      <span class="meta-tag">INITIALIZATION PROTOCOL &bull; DIRECT DISPATCH</span>
    </div>
    <div class="meta-right">
      <span class="meta-annotation font-mono">RESPONSE TIME: &lt; 24 HOURS // REAL ENGINEERS</span>
    </div>
  </div>

  <div class="contact-layout">
    <!-- Left Column: Direct Dispatch & Coordinates -->
    <div class="contact-info-cell border-r">
      <div class="info-header">
        <span class="tech-tag tech-tag-acid font-mono">DIRECT ACCESS // NO SALES PADDING</span>
        <h2 class="contact-headline">
          Initialize <span class="font-serif-italic acid-italic">engagement</span>. Skip the sales runaround.
        </h2>
        <p class="contact-lead">
          Tell us about your systems architecture, voice campaign, clean data backlog, or US medical billing requirements. You speak directly to senior leads who build and run operations.
        </p>
      </div>

      <div class="direct-channels font-mono">
        <div class="channel-card">
          <span class="channel-lbl">DISPATCH EMAIL</span>
          <a href="mailto:wisdomtechnosoft04@gmail.com" class="channel-val">wisdomtechnosoft04@gmail.com</a>
        </div>

        <div class="channel-card">
          <span class="channel-lbl">DIRECT VOICE LINE</span>
          <a href="tel:+917447331127" class="channel-val">+91 74473 31127</a>
        </div>

        <div class="channel-card">
          <span class="channel-lbl">DELIVERY HUB COORDINATES</span>
          <a href="https://maps.google.com/?q=Opposite+Bank+of+Baroda,+Ward+Number+3,+Parsodi,+Trimurtee+Nagar,+Nagpur,+Maharashtra+440022" target="_blank" rel="noopener" class="channel-val address-val">
            Opposite Bank of Baroda, Ward Number 3, Parsodi, Trimurtee Nagar, Nagpur &ndash; 440022, Maharashtra, India
          </a>
        </div>
      </div>

      <div class="whatsapp-row">
        <a class="btn-industrial btn-outline-ink whatsapp-btn font-mono" href="https://wa.me/917447331127?text=Hello%20Wisdom%20Technosoft%2C%20I%20would%20like%20to%20discuss%20an%20engineering%2Foperations%20project." target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>CHAT ON WHATSAPP DIRECT</span>
        </a>
      </div>

      <div class="sla-reassurance font-mono">
        <span class="status-pip-acid"></span>
        <span>SLA: INQUIRIES ROUTED DIRECTLY TO SYSTEM PRINCIPALS</span>
      </div>
    </div>

    <!-- Right Column: Structured Transmission Form -->
    <div class="contact-form-cell">
      <form class="transmission-form" id="cform" action="/api/contact" method="POST">
        <div class="form-banner font-mono">
          <span>TRANSMIT SPECIFICATION</span>
          <span style="color: var(--accent-signal)">[POST /api/contact]</span>
        </div>

        <!-- Honeypot -->
        <div class="hp" aria-hidden="true" style="display: none;">
          <label for="f-web">Leave empty</label>
          <input id="f-web" name="website_url" tabindex="-1" autocomplete="off" />
        </div>

        <div class="fields-grid font-mono">
          <div class="field-item">
            <label for="f-name">NAME <span class="req">*</span></label>
            <input id="f-name" name="name" required autocomplete="name" placeholder="Aarav Sharma" />
          </div>

          <div class="field-item">
            <label for="f-email">CORPORATE EMAIL <span class="req">*</span></label>
            <input id="f-email" type="email" name="email" required autocomplete="email" placeholder="aarav@company.com" />
          </div>

          <div class="field-item">
            <label for="f-phone">PHONE / WHATSAPP</label>
            <input id="f-phone" type="tel" name="phone" autocomplete="tel" placeholder="+91 98765 43210" />
          </div>

          <div class="field-item">
            <label for="f-service">SYSTEM REQUIREMENT</label>
            <select id="f-service" name="service">
              <option value="Software Development">Software &amp; Cloud Edge Platforms</option>
              <option value="Telecalling Services">Voice &amp; 24/7 Telecalling Operations</option>
              <option value="Data Entry & Management">Clean Data Mining &amp; Double-Blind QA</option>
              <option value="Business Process & Industrial Solutions">Industrial Process &amp; Back-Office</option>
              <option value="Healthcare Support / US Medical Billing">US Healthcare Support &amp; Medical Billing (RCM)</option>
              <option value="General Inquiry">General Architecture Inquiry</option>
            </select>
          </div>

          <div class="field-item full-width">
            <label for="f-message">SYSTEM SPECIFICATIONS &amp; OBJECTIVES <span class="req">*</span></label>
            <textarea id="f-message" name="message" rows="5" required placeholder="Describe technical scope, timeline, volume, or key operational bottlenecks..."></textarea>
          </div>
        </div>

        <div class="form-submit-bar font-mono">
          <button class="btn-industrial btn-signal" type="submit" id="send">
            <span>TRANSMIT INQUIRY</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <span class="form-confidential">PRIVACY: NO TRACKERS &bull; DIRECT DISPATCH</span>
        </div>

        <div class="status-box font-mono" id="status" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("cform") as HTMLFormElement | null;
  const send = document.getElementById("send") as HTMLButtonElement | null;
  const status = document.getElementById("status") as HTMLElement | null;

  if (form && send && status) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      send.disabled = true;
      const originalText = send.innerHTML;
      send.innerHTML = '<span>TRANSMITTING...</span>';
      status.className = "status-box font-mono is-active is-pending";
      status.textContent = "Connecting to dispatch endpoint...";

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          status.className = "status-box font-mono is-active is-success";
          status.textContent = "TRANSMISSION CONFIRMED. An engineering lead will review your specifications within 1 business day.";
          form.reset();
        } else {
          status.className = "status-box font-mono is-active is-error";
          status.textContent = data.message || "Transmission failed. Please dispatch directly to wisdomtechnosoft04@gmail.com";
        }
      } catch {
        status.className = "status-box font-mono is-active is-error";
        status.textContent = "Network error. Dispatch directly via wisdomtechnosoft04@gmail.com or WhatsApp.";
      } finally {
        send.disabled = false;
        send.innerHTML = originalText;
      }
    });
  }
</script>

<style>
  .contact-section {
    background-color: var(--bg-ink);
    color: var(--text-on-ink);
    position: relative;
    border-bottom: 1px solid var(--border-ink);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr;
  }

  /* Left Column */
  .contact-info-cell {
    padding: clamp(36px, 5vw, 64px) var(--grid-pad);
    border-right: 1px solid var(--border-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 36px;
    background: rgba(0, 0, 0, 0.2);
  }

  .contact-headline {
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-top: 16px;
  }

  .acid-italic {
    color: var(--accent-acid);
  }

  .contact-lead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--text-muted-ink);
    margin-top: 16px;
    max-width: 48ch;
  }

  .direct-channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channel-card {
    padding: 16px 20px;
    border: 1px solid var(--border-ink);
    background: var(--bg-surface-ink);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.15s ease;
  }

  .channel-card:hover {
    border-color: var(--accent-acid);
  }

  .channel-lbl {
    font-size: 10px;
    color: var(--text-muted-ink);
    letter-spacing: 0.08em;
  }

  .channel-val {
    font-size: 13.5px;
    font-weight: 700;
    color: #F4F2EC;
    text-decoration: none;
    line-height: 1.4;
  }

  .channel-val:hover {
    color: var(--accent-acid);
  }

  .address-val {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-muted-ink);
  }

  .whatsapp-btn {
    width: 100%;
    padding: 14px 20px;
    font-size: 11px;
    letter-spacing: 0.06em;
    gap: 10px;
  }

  .sla-reassurance {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: var(--accent-acid);
    letter-spacing: 0.05em;
  }

  /* Right Column: Form */
  .contact-form-cell {
    padding: clamp(36px, 5vw, 64px) var(--grid-pad);
    background: var(--bg-ink);
    display: flex;
    flex-direction: column;
  }

  .form-banner {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    padding-bottom: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border-ink);
    letter-spacing: 0.08em;
  }

  .fields-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .field-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-item.full-width {
    grid-column: 1 / -1;
  }

  .field-item label {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--text-muted-ink);
  }

  .req {
    color: var(--accent-signal);
  }

  .field-item input,
  .field-item select,
  .field-item textarea {
    background: var(--bg-surface-ink);
    border: 1px solid var(--border-ink);
    color: #F4F2EC;
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 13.5px;
    border-radius: 0;
    transition: border-color 0.15s ease, background 0.15s ease;
    outline: none;
  }

  .field-item input:focus,
  .field-item select:focus,
  .field-item textarea:focus {
    border-color: var(--accent-signal);
    background: #181B1F;
  }

  .field-item select {
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }

  .form-submit-bar {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .form-confidential {
    font-size: 10px;
    color: var(--text-muted-ink);
    letter-spacing: 0.06em;
  }

  /* Status Box */
  .status-box {
    margin-top: 20px;
    padding: 14px 18px;
    font-size: 11px;
    letter-spacing: 0.04em;
    display: none;
    border: 1px solid transparent;
  }

  .status-box.is-active {
    display: block;
  }

  .status-box.is-pending {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-ink);
    color: var(--text-on-ink);
  }

  .status-box.is-success {
    background: rgba(200, 255, 0, 0.08);
    border-color: var(--accent-acid);
    color: var(--accent-acid);
  }

  .status-box.is-error {
    background: rgba(255, 59, 0, 0.08);
    border-color: var(--accent-signal);
    color: var(--accent-signal);
  }

  /* Responsive Matrix */
  @media (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .contact-info-cell {
      border-right: none;
      border-bottom: 1px solid var(--border-ink);
    }
  }

  @media (max-width: 640px) {
    .fields-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
