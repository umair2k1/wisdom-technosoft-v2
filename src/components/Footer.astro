</footer>

<style>
  .site-colophon {
    background-color: var(--bg-paper);
    color: var(--text-primary);
    position: relative;
    border-top: 1px solid var(--border-paper);
  }

  .colophon-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    border-bottom: 1px solid var(--border-paper);
  }

  .col-cell {
    padding: clamp(28px, 4vw, 48px) 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Brand Cell */
  .col-brand {
    gap: 20px;
  }

  .col-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .col-logo {
    display: block;
    object-fit: contain;
  }

  .col-logo-text {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .col-bio {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 44ch;
  }

  .col-meta-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    border: 1px solid var(--border-paper);
    background: var(--bg-surface);
    font-size: 10px;
    color: var(--text-muted);
  }

  .meta-box-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pip-orange {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-signal);
  }

  /* Links Cells */
  .col-header {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.08em;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-paper);
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-anchor {
    font-size: 12px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .col-anchor:hover {
    color: var(--accent-signal);
  }

  .col-idx {
    color: var(--accent-signal);
    font-weight: 700;
    margin-right: 4px;
  }

  /* Dispatch Group */
  .col-dispatch {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dispatch-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .d-label {
    font-size: 9.5px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .d-val {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .d-val:hover {
    color: var(--accent-signal);
  }

  .d-addr {
    font-family: var(--font-body);
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* Bottom Colophon Bar */
  .colophon-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--grid-pad);
    font-size: 10.5px;
    color: var(--text-muted);
    gap: 16px;
  }

  .colophon-legal {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .legal-link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .legal-link:hover {
    color: var(--accent-signal);
  }

  .colophon-runtime {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .runtime-tag {
    color: var(--accent-signal);
    font-weight: 700;
  }

  .top-anchor {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .top-anchor:hover {
    color: var(--accent-signal);
  }

  /* Responsive Matrix */
  @media (max-width: 1080px) {
    .colophon-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .col-cell:nth-child(2) {
      border-right: none;
    }
    .col-cell:nth-child(1),
    .col-cell:nth-child(2) {
      border-bottom: 1px solid var(--border-paper);
    }
  }

  @media (max-width: 640px) {
    .colophon-grid {
      grid-template-columns: 1fr;
    }
    .col-cell {
      border-right: none;
      border-bottom: 1px solid var(--border-paper);
    }
    .col-cell:last-child {
      border-bottom: none;
    }
    .colophon-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
