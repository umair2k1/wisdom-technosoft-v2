        <span class="meta-box-item">EDGE DEPLOYMENT: CLOUDFLARE</span>
      </div>
    </div>

    <!-- Solutions Links Cell -->
    <div class="col-cell border-r font-mono">
      <span class="col-header">[SOLUTIONS // SPEC]</span>
      <ul class="col-list">
        <li><a href="#services" class="col-anchor">Custom Software Engineering</a></li>
        <li><a href="#services" class="col-anchor">B2B Voice &amp; Telecalling</a></li>
