    <!-- Navigation Links Cell -->
    <div class="col-cell border-r font-mono">
      <span class="col-header">[NAVIGATION // ROUTE]</span>
      <ul class="col-list">
        <li><a href="#services" class="col-anchor"><span class="col-idx">[01]</span> Capabilities</a></li>
        <li><a href="#approach" class="col-anchor"><span class="col-idx">[02]</span> Disciplines &amp; SLAs</a></li>
        <li><a href="#vision" class="col-anchor"><span class="col-idx">[03]</span> System Spec &amp; Values</a></li>
        <li><a href="#team" class="col-anchor"><span class="col-idx">[04]</span> Division Leads</a></li>
        <li><a href="#contact" class="col-anchor"><span class="col-idx">[05]</span> Transmit Inquiry</a></li>
      </ul>
