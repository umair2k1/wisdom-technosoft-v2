    <!-- Direct Hotline & Dispatch Cell -->
    <div class="col-cell font-mono">
      <span class="col-header">[DIRECT DISPATCH]</span>
      <div class="col-dispatch">
        <div class="dispatch-group">
          <span class="d-label">TELEPHONE</span>
          <a href="tel:+917447331127" class="d-val">+91 74473 31127</a>
        </div>
        <div class="dispatch-group">
          <span class="d-label">EMAIL</span>
          <a href="mailto:wisdomtechnosoft04@gmail.com" class="d-val">wisdomtechnosoft04@gmail.com</a>
        </div>
        <div class="dispatch-group">
          <span class="d-label">POSTAL ADDRESS</span>
          <p class="d-addr">Opposite Bank of Baroda, Ward Number 3, Parsodi, Trimurtee Nagar, Nagpur &ndash; 440022, MH, India</p>
