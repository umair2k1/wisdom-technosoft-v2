<style>
  .site-footer {
    position: relative;
    padding-top: clamp(60px, 10vh, 100px);
    padding-bottom: 40px;
    background-color: var(--bg);
    color: var(--ink);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .footer-top {
    padding: 48px;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 40px;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 440px;
  }

  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-logo {
    width: 32px;
    height: auto;
  }

  .footer-logo-light { display: none; }
  .footer-logo-dark { display: block; }
  [data-theme="blueprint"] .footer-logo-light,
  .theme-blueprint .footer-logo-light { display: block; }
  [data-theme="blueprint"] .footer-logo-dark,
  .theme-blueprint .footer-logo-dark { display: none; }

  .footer-brand-title {
    font-family: var(--disp);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .footer-bio {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .footer-coord {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .coord-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .col-title {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 13.5px;
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-contact-stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: var(--mono);
  }

  .fc-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fc-lbl {
    font-size: 9.5px;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  .fc-val {
    font-size: 13px;
    color: var(--ink);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .fc-val:hover {
    color: var(--accent);
  }

  /* Bottom Telemetry Strip */
  .footer-bottom-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 10.5px;
  }

  .telemetry-readout {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-muted);
  }

  .telemetry-readout strong {
    color: var(--ink);
  }

  .t-pulse {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }

  .footer-bottom-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .copyright {
    color: var(--ink-muted);
  }

  .foot-link {
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }

  .foot-link:hover {
    color: var(--accent);
  }

  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .footer-bottom-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .footer-bottom-right {
      flex-wrap: wrap;
      gap: 12px;
    }
  }
</style>
