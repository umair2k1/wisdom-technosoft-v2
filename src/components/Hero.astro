---
---

<section class="hero-section junction-marker" id="top" data-theme="paper">
  <!-- Section Meta Bar -->
  <div class="section-meta-bar">
    <div class="meta-left">
      <span class="meta-index">[SYS // 001]</span>
      <span class="meta-tag">ARCHITECTURE &bull; DISPATCH MATRIX</span>
    </div>
    <div class="meta-right">
      <span class="meta-annotation font-mono">THREAD: GPU COMPOSITOR &bull; BUZZWORDS REDACTED: 42</span>
    </div>
  </div>

  <div class="hero-layout">
    <!-- Left: Editorial Headline & Manifesto -->
    <div class="hero-main-cell">
      <div class="hero-header-block">
        <div class="hero-eyebrow-row">
          <span class="status-pip"></span>
          <span class="font-mono eyebrow-text">NAGPUR PRODUCTION HUB // 21.1458° N, 79.0882° E</span>
        </div>

        <h1 class="hero-headline">
          We write <span class="font-serif-italic headline-italic">production</span> code for companies tired of agencies that subcontract to templates.
        </h1>

        <p class="hero-manifesto">
          No fake ping tickers. No 4MB Three.js spinning globes. Just custom cloud software, disciplined telecalling squads, double-blind data pipelines, and HIPAA-grade US medical billing that survive real Monday morning traffic spikes.
        </p>

        <div class="hero-actions-row">
          <a href="#contact" class="btn-industrial btn-signal">
            <span>INITIALIZE ENGAGEMENT</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#services" class="btn-industrial btn-outline-paper">
            <span>INSPECT CAPABILITIES</span>
            <span class="font-mono" style="opacity: 0.6">[01]</span>
          </a>
        </div>
      </div>

      <!-- Micro Engineering Annotations Banner -->
      <div class="hero-debug-strip font-mono">
        <div class="debug-col">
          <span class="debug-lbl">JS SCROLL LISTENERS</span>
          <span class="debug-val" style="color: var(--accent-signal)">0 (NATIVE CSS TIMELINE)</span>
        </div>
        <div class="debug-col">
          <span class="debug-lbl">VENDOR VIBE-CODE</span>
          <span class="debug-val">REFACTORED</span>
        </div>
        <div class="debug-col">
          <span class="debug-lbl">CORE RUNTIME</span>
          <span class="debug-val">ZERO CLIENT BLOAT</span>
        </div>
      </div>
    </div>

    <!-- Right: Engineering Specification Console -->
    <div class="hero-spec-cell">
      <div class="spec-console-header">
        <div class="console-title font-mono">
          <span class="console-icon">SYS::SPEC</span>
          <span>SYSTEM ARCHITECTURE SUMMARY</span>
        </div>
        <span class="tech-tag tech-tag-signal font-mono">REV 2.0 // DEPLOYED</span>
      </div>

      <div class="spec-items-list font-mono">
        <!-- Spec 01 -->
        <div class="spec-row">
          <div class="spec-row-top">
            <span class="spec-code">[SYS-01]</span>
            <span class="spec-title">CLOUD &amp; SOFTWARE SYSTEMS</span>
            <span class="spec-status">ACTIVE</span>
          </div>
          <p class="spec-desc">
            Cloudflare edge microservices, Astro/React platforms, resilient APIs, and workflow automation. Built to never wake you up at 3 AM.
          </p>
          <div class="spec-meta">
            <span>STACK: TS / NODE / POSTGRES</span>
            <span>EDGE: CLOUDFLARE</span>
          </div>
        </div>

        <!-- Spec 02 -->
        <div class="spec-row">
          <div class="spec-row-top">
            <span class="spec-code">[SYS-02]</span>
            <span class="spec-title">VOICE &amp; TELECALLING SQUADS</span>
            <span class="spec-status">ACTIVE</span>
          </div>
          <p class="spec-desc">
            Tri-lingual inbound and outbound voice operations. Neutral English, Hindi &amp; regional teams trained for enterprise customer conversion.
          </p>
          <div class="spec-meta">
            <span>COVERAGE: 24/7/365</span>
            <span>SQUAD: DEDICATED</span>
          </div>
        </div>

        <!-- Spec 03 -->
        <div class="spec-row">
          <div class="spec-row-top">
            <span class="spec-code">[SYS-03]</span>
            <span class="spec-title">DATA EXTRACTION &amp; DOUBLE-BLIND QA</span>
            <span class="spec-status">ACTIVE</span>
          </div>
          <p class="spec-desc">
            Double-blind verification, fuzzy deduplication, and structured ETL datasets. Zero dirty records admitted into production.
          </p>
          <div class="spec-meta">
            <span>PRECISION: 99.8% SLA</span>
            <span>AUDIT: DUAL-KEYED</span>
          </div>
        </div>

        <!-- Spec 04 -->
        <div class="spec-row">
          <div class="spec-row-top">
            <span class="spec-code">[SYS-04]</span>
            <span class="spec-title">HEALTHCARE RCM &amp; MEDICAL BILLING</span>
            <span class="spec-status">ACTIVE</span>
          </div>
          <p class="spec-desc">
            HIPAA-compliant CPT/ICD-10 charge capture, insurance eligibility, denial management, and accelerated revenue cycle recovery.
          </p>
          <div class="spec-meta">
            <span>CLEAN CLAIMS: 98.7%</span>
            <span>COMPLIANCE: HIPAA</span>
          </div>
        </div>
      </div>

      <div class="spec-console-footer font-mono">
        <span class="console-foot-item">UPTIME SLA: <strong>99.8%</strong></span>
        <span class="console-foot-item">SHIFTS: <strong>24/7 COVERAGE</strong></span>
      </div>
    </div>
  </div>

  <!-- Bottom Metric Strip -->
  <div class="hero-metric-grid font-mono">
    <div class="metric-cell">
      <div class="metric-top">
        <span class="metric-val">99.8%</span>
        <span class="metric-tag">VERIFIED</span>
      </div>
      <p class="metric-caption">Double-blind data QA precision and service-level contract adherence.</p>
    </div>

    <div class="metric-cell">
      <div class="metric-top">
        <span class="metric-val">24/7/365</span>
        <span class="metric-tag">CONTINUOUS</span>
      </div>
      <p class="metric-caption">Nagpur operations center supporting US Eastern and Indian standard shifts.</p>
    </div>

    <div class="metric-cell">
      <div class="metric-top">
        <span class="metric-val">0 KB</span>
        <span class="metric-tag">PURE CSS</span>
      </div>
      <p class="metric-caption">Scroll-driven animation overhead. Zero main-thread JS animation jank.</p>
    </div>

    <div class="metric-cell">
      <div class="metric-top">
        <span class="metric-val">65–75%</span>
        <span class="metric-tag">OPEX GAIN</span>
      </div>
      <p class="metric-caption">Cost advantage over onshore models with direct senior engineering access.</p>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    border-bottom: 1px solid var(--border-paper);
    background-color: var(--bg-paper);
    overflow: hidden;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    border-bottom: 1px solid var(--border-paper);
  }

  /* Left Main Cell */
  .hero-main-cell {
    padding: clamp(32px, 5vw, 64px) var(--grid-pad);
    border-right: 1px solid var(--border-paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
  }

  .hero-eyebrow-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-paper);
    margin-bottom: 24px;
  }

  .eyebrow-text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-primary);
  }

  .hero-headline {
    font-size: clamp(2.4rem, 4.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    max-width: 22ch;
  }

  .headline-italic {
    font-size: 1.08em;
    color: var(--accent-signal);
    padding-inline: 2px;
  }

  .hero-manifesto {
    margin-top: 24px;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 54ch;
  }

  .hero-actions-row {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  /* Debug Strip */
  .hero-debug-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border-paper);
    font-size: 11px;
  }

  .debug-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .debug-lbl {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .debug-val {
    font-weight: 700;
  }

  /* Right Spec Console Cell */
  .hero-spec-cell {
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
  }

  .spec-console-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-paper);
    background: rgba(0, 0, 0, 0.03);
  }

  .console-title {
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .console-icon {
    color: var(--accent-signal);
  }

  .spec-items-list {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .spec-row {
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-paper);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.15s ease;
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  .spec-row:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  .spec-row-top {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }

  .spec-code {
    color: var(--accent-signal);
    font-weight: 700;
  }

  .spec-title {
    font-weight: 700;
    color: var(--text-primary);
    flex: 1;
  }

  .spec-status {
    font-size: 10px;
    color: var(--text-muted);
    border: 1px solid var(--border-paper);
    padding: 2px 6px;
  }

  .spec-desc {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .spec-meta {
    display: flex;
    gap: 16px;
    font-size: 10px;
    color: var(--text-muted);
    padding-top: 4px;
  }

  .spec-console-footer {
    display: flex;
    justify-content: space-between;
    padding: 14px 24px;
    border-top: 1px solid var(--border-paper);
    font-size: 11px;
    background: rgba(0, 0, 0, 0.03);
  }

  /* Bottom Metric Strip */
  .hero-metric-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .metric-cell {
    padding: 28px 24px;
    border-right: 1px solid var(--border-paper);
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--bg-paper);
    transition: background-color 0.15s ease;
  }

  .metric-cell:last-child {
    border-right: none;
  }

  .metric-cell:hover {
    background: var(--bg-surface);
  }

  .metric-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .metric-val {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .metric-tag {
    font-size: 10px;
    color: var(--accent-signal);
    border: 1px solid rgba(255, 59, 0, 0.3);
    padding: 2px 6px;
  }

  .metric-caption {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Responsive Matrix */
  @media (max-width: 1024px) {
    .hero-layout {
      grid-template-columns: 1fr;
    }
    .hero-main-cell {
      border-right: none;
      border-bottom: 1px solid var(--border-paper);
    }
    .hero-metric-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .metric-cell:nth-child(2) {
      border-right: none;
    }
    .metric-cell:nth-child(1),
    .metric-cell:nth-child(2) {
      border-bottom: 1px solid var(--border-paper);
    }
  }

  @media (max-width: 640px) {
    .hero-metric-grid {
      grid-template-columns: 1fr;
    }
    .metric-cell {
      border-right: none;
      border-bottom: 1px solid var(--border-paper);
    }
    .metric-cell:last-child {
      border-bottom: none;
    }
  }

  /* Scroll-driven API hook */
  @supports (animation-timeline: view()) {
    .hero-header-block {
      animation: hero-parallax-fade linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 100%;
    }
  }
</style>
