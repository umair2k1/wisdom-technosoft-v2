---
// Wisdom Technosoft — Hero Component
// Multi-Layer X-Ray Blueprint Scrub • Architectural Reticle • Hero-to-Nav Logo Docking
---

<section class="hero-section s" id="top">
  <!-- Crosshairs on container bounds -->
  <div class="hero-wrapper w">
    
    <!-- Top Blueprint Header Strip -->
    <div class="hero-spec-strip">
      <div class="spec-left">
        <span class="blueprint-tag active"><span class="tag-dot"></span> NAGPUR OPERATIONAL CORE</span>
        <span class="spec-coord">COORD // 21.1458° N, 79.0882° E</span>
      </div>
      <div class="spec-right">
        <span class="spec-telemetry">
          REAL METRIC // PAINT: <strong class="real-paint-stat">--ms</strong> &bull; <strong class="real-fps-stat">60 FPS</strong>
        </span>
      </div>
    </div>

    <!-- Main Pin / Scrub Viewport -->
    <div class="hero-stage" id="hero-stage">
      
      <!-- LAYER 1: Editorial Surface ("What We Build") -->
      <div class="hero-layer hero-layer-surface" id="hero-layer-surface">
        <div class="hero-grid">
          
          <!-- Left Column: Architectural Editorial Headlines -->
          <div class="hero-main-col">
            <div class="hero-eyebrow-box">
              <span class="eyebrow">EDITORIAL SYSTEMS &bull; BPO SCALE</span>
              <span class="eyebrow-pill">NO VIBE-CODING</span>
            </div>

            <h1 class="hero-title">
              <span class="title-line">We write code that</span>
              <span class="title-line title-highlight">survives Monday mornings.</span>
              <span class="title-line title-muted">Software. Voice. Clean data.</span>
            </h1>

            <p class="hero-lead">
              A premier Nagpur studio delivering custom software engineering, high-touch telecalling squads, meticulous data management, and mission-critical back-office operations &mdash; one unified team, one uncompromising standard.
            </p>

            <div class="hero-actions-row">
              <a class="btn btn-primary" href="#contact">
                <span>Start a project</span>
                <span>&rarr;</span>
              </a>
              <a class="btn btn-secondary" href="#services">
                <span>Inspect Capabilities</span>
                <span>// 05</span>
              </a>
              <div class="hero-honest-badge">
                <span class="badge-icon">&check;</span>
                <span>Zero fake metrics. 100% human rigor.</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Precision Reticle & Logo Focal Piece -->
          <div class="hero-focal-col">
            <div class="hero-reticle-wrap" id="hero-reticle-wrap">
              <!-- SVG Architectural Drafting Reticle -->
              <svg class="reticle-svg" viewBox="0 0 340 340" aria-hidden="true">
                <circle cx="170" cy="170" r="160" class="r-outer-ring" stroke-dasharray="4 6" />
                <circle cx="170" cy="170" r="130" class="r-mid-ring" />
                <circle cx="170" cy="170" r="90" class="r-inner-ring" stroke-dasharray="2 4" />
                
                <!-- Coordinate crosshairs -->
                <line x1="10" y1="170" x2="330" y2="170" class="r-axis" />
                <line x1="170" y1="10" x2="170" y2="330" class="r-axis" />
                
                <!-- Caliper ticks -->
                <line x1="170" y1="10" x2="170" y2="24" class="r-tick" />
                <line x1="170" y1="316" x2="170" y2="330" class="r-tick" />
                <line x1="10" y1="170" x2="24" y2="170" class="r-tick" />
                <line x1="316" y1="170" x2="330" y2="170" class="r-tick" />

                <!-- Corner framing calipers -->
                <path d="M 30,50 L 30,30 L 50,30" class="r-bracket" />
                <path d="M 310,50 L 310,30 L 290,30" class="r-bracket" />
                <path d="M 30,290 L 30,310 L 50,310" class="r-bracket" />
                <path d="M 310,290 L 310,310 L 290,310" class="r-bracket" />

                <!-- Technical Labels -->
                <text x="180" y="28" class="r-text">RAD // 130MM</text>
                <text x="180" y="325" class="r-text">SYSTEM // MK-IV</text>
                <text x="18" y="162" class="r-text">AXIS-X</text>
                <text x="282" y="162" class="r-text">AXIS-Y</text>
              </svg>

              <!-- Focal Logo Piece (Target for GSAP Scroll Docking to Nav) -->
              <div class="hero-logo-anchor" id="hero-logo-anchor">
                <img src="/assets/logo-ghost.png" alt="" class="hero-ghost-watermark" aria-hidden="true" />
                <img src="/assets/logo-mark.png" alt="Wisdom Technosoft Logo" class="hero-dock-mark" id="hero-dock-mark" width="110" height="90" />
                <div class="logo-status-tag">CORE OPERATIONAL HUB</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- LAYER 2: "Under the Hood" Engineering Schematic (Revealed on X-Ray Scrub) -->
      <div class="hero-layer hero-layer-blueprint" id="hero-layer-blueprint">
        <div class="blueprint-xray-content">
          <div class="xray-header">
            <span class="xray-tag">&Delta; UNDER THE HOOD // ARCHITECTURAL SCHEMATIC</span>
            <span class="xray-sub">PEELING BACK MARKETING TO REVEAL REAL RUNTIME GUARANTEES</span>
          </div>

          <div class="xray-schematic-grid">
            <div class="xray-card">
              <span class="xray-node-id">NODE // 01</span>
              <h4>0% Hallucinated Microservices</h4>
              <p>Boring, battle-tested software architecture. High-performance Astro SSR, strict TypeScript types, PostgreSQL with connection pooling, and zero superfluous dependencies.</p>
              <div class="xray-badge-row">
                <span class="mono-chip">P99 &lt; 40MS</span>
                <span class="mono-chip">ZERO DOWNTIME DEPLOYS</span>
              </div>
            </div>

            <div class="xray-card">
              <span class="xray-node-id">NODE // 02</span>
              <h4>Double-Blind Data Pipeline</h4>
              <p>Every data mining and catalog batch passes automated schema sanitization, regex checksums, and two independent human verification passes before client delivery.</p>
              <div class="xray-badge-row">
                <span class="mono-chip">99.8% VERIFIED QA</span>
                <span class="mono-chip">FUZZY DEDUPING</span>
              </div>
            </div>

            <div class="xray-card">
              <span class="xray-node-id">NODE // 03</span>
              <h4>Human Telecalling Squads</h4>
              <p>No robotic auto-dialer hallucination. Tri-lingual squads with domain training in client workflows, objection handling, and strict call quality scoring.</p>
              <div class="xray-badge-row">
                <span class="mono-chip">3 LANGUAGES</span>
                <span class="mono-chip">REAL-TIME CALL QA</span>
              </div>
            </div>

            <div class="xray-card">
              <span class="xray-node-id">NODE // 04</span>
              <h4>HIPAA &amp; Clean Claims RCM</h4>
              <p>End-to-end US medical billing support. CPT/ICD-10 certified scrubbers ensuring clean first-pass submission rates that outperform industry medians.</p>
              <div class="xray-badge-row">
                <span class="mono-chip">98.7% CLEAN CLAIMS</span>
                <span class="mono-chip">HIPAA ENFORCED</span>
              </div>
            </div>
          </div>

          <div class="xray-footer">
            <span class="xray-quote">&ldquo;Good engineering is quiet. It doesn't break at 3 AM.&rdquo;</span>
            <span class="xray-stamp">VERIFIED BY WISDOM TECHNOSOFT ENG SQUAD</span>
          </div>
        </div>
      </div>

    </div>

    <!-- 4 Precision Metric Cards in Swiss Hairline Grid -->
    <div class="hero-metrics-grid">
      <div class="metric-block grid-frame">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="metric-top">
          <span class="metric-value">99.8%</span>
          <span class="metric-pill">VERIFIED</span>
        </div>
        <h3 class="metric-title">Data Accuracy &amp; QA Precision</h3>
        <p class="metric-desc">Multi-tier double-blind verification across every data ETL pipeline.</p>
      </div>

      <div class="metric-block grid-frame">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="metric-top">
          <span class="metric-value">24/7/365</span>
          <span class="metric-pill">CONTINUOUS</span>
        </div>
        <h3 class="metric-title">Active Shift Coverage</h3>
        <p class="metric-desc">Unbroken operational support spanning US, UK, and Indian business hours.</p>
      </div>

      <div class="metric-block grid-frame">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="metric-top">
          <span class="metric-value">Tri-Lingual</span>
          <span class="metric-pill">VOICE</span>
        </div>
        <h3 class="metric-title">English, Hindi &amp; Regional</h3>
        <p class="metric-desc">Neutral accent, culturally aligned voice squads for inbound and outbound calls.</p>
      </div>

      <div class="metric-block grid-frame">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="metric-top">
          <span class="metric-value">100%</span>
          <span class="metric-pill">CONTRACTUAL</span>
        </div>
        <h3 class="metric-title">Milestone SLA Adherence</h3>
        <p class="metric-desc">Predictable sprint cadences, transparent dashboards, zero mystery delays.</p>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: calc(var(--nav-h, 70px) + 24px);
    padding-bottom: 72px;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero-spec-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 11px;
    margin-bottom: 24px;
    letter-spacing: 0.05em;
  }

  .spec-left, .spec-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .spec-coord {
    color: var(--ink-muted);
  }

  .spec-telemetry {
    color: var(--ink-muted);
  }
  .spec-telemetry strong {
    color: var(--ink);
  }

  /* Pin / Scrub Stage */
  .hero-stage {
    position: relative;
    border: 1px solid var(--border-strong);
    background: var(--surface-card);
    min-height: 520px;
    overflow: hidden;
  }

  .hero-layer {
    width: 100%;
    height: 100%;
    padding: 48px;
  }

  /* Layer 1: Surface */
  .hero-layer-surface {
    position: relative;
    z-index: 2;
    background: var(--surface-card);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 48px;
    align-items: center;
  }

  .hero-eyebrow-box {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .eyebrow-pill {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 700;
    padding: 2px 6px;
    border: 1px solid var(--border-strong);
    color: var(--ink-muted);
  }

  .hero-title {
    font-family: var(--disp);
    font-size: clamp(2.4rem, 5.2vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin-bottom: 24px;
  }

  .title-line {
    display: block;
  }

  .title-highlight {
    color: var(--accent);
    position: relative;
  }

  .title-muted {
    color: var(--ink-muted);
    font-weight: 600;
    font-size: 0.8em;
    margin-top: 4px;
  }

  .hero-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 58ch;
    margin-bottom: 36px;
  }

  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .hero-honest-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-muted);
  }

  .badge-icon {
    color: var(--accent);
    font-weight: 700;
  }

  /* Reticle & Focal Logo Piece */
  .hero-focal-col {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-reticle-wrap {
    position: relative;
    width: 320px;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reticle-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .r-outer-ring,
  .r-mid-ring,
  .r-inner-ring {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .r-axis {
    stroke: var(--grid-strong);
    stroke-width: 1;
  }

  .r-tick {
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .r-bracket {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    opacity: 0.7;
  }

  .r-text {
    font-family: var(--mono);
    font-size: 8px;
    fill: var(--ink-muted);
    letter-spacing: 0.08em;
  }

  .hero-logo-anchor {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  .hero-ghost-watermark {
    position: absolute;
    width: 220px;
    height: auto;
    opacity: 0.08;
    pointer-events: none;
    transform: rotate(-12deg);
  }

  .hero-dock-mark {
    position: relative;
    width: 96px;
    height: auto;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.08));
    will-change: transform, opacity;
  }

  .logo-status-tag {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding: 2px 6px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  /* LAYER 2: Blueprint Schematic X-Ray */
  .hero-layer-blueprint {
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: #0A0D14;
    color: #F4F1EA;
    background-image: 
      linear-gradient(rgba(0, 229, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 229, 255, 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    /* GSAP scrubs this clip-path to peel back the layer */
    clip-path: polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%);
    will-change: clip-path;
  }

  .blueprint-xray-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .xray-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(0, 229, 255, 0.2);
    font-family: var(--mono);
  }

  .xray-tag {
    color: #00E5FF;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .xray-sub {
    font-size: 10.5px;
    color: #8E9BAE;
  }

  .xray-schematic-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 32px 0;
  }

  .xray-card {
    border: 1px solid rgba(0, 229, 255, 0.18);
    background: rgba(16, 21, 32, 0.85);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .xray-node-id {
    font-family: var(--mono);
    font-size: 10px;
    color: #00E5FF;
    margin-bottom: 8px;
    letter-spacing: 0.06em;
  }

  .xray-card h4 {
    font-family: var(--disp);
    font-size: 16px;
    font-weight: 700;
    color: #F4F1EA;
    margin-bottom: 10px;
  }

  .xray-card p {
    font-size: 12.5px;
    line-height: 1.5;
    color: #A5B2C5;
    margin-bottom: 16px;
  }

  .xray-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mono-chip {
    font-family: var(--mono);
    font-size: 9px;
    color: #00E5FF;
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.2);
    padding: 2px 6px;
  }

  .xray-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 229, 255, 0.2);
    font-family: var(--mono);
    font-size: 11px;
  }

  .xray-quote {
    color: #00E5FF;
    font-style: italic;
  }

  .xray-stamp {
    color: #8E9BAE;
    font-size: 10px;
  }

  /* 4 Bottom Metric Blocks */
  .hero-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .metric-block {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .metric-value {
    font-family: var(--disp);
    font-size: 32px;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .metric-pill {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    padding: 2px 6px;
    background: var(--surface);
  }

  .metric-title {
    font-family: var(--disp);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .metric-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-focal-col {
      display: none;
    }
    .xray-schematic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .hero-layer {
      padding: 24px;
    }
    .hero-spec-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .xray-schematic-grid {
      grid-template-columns: 1fr;
    }
    .hero-metrics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
