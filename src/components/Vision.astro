---
---

<section class="s vision" id="vision" style="--bg:var(--deep);--fg:var(--ivory)">
  <div class="vscroll">
    <div class="vstick">
      <svg class="vring" viewBox="0 0 400 400" aria-hidden="true">
        <defs>
          <path id="rp" d="M200 200m-170 0a170 170 0 1 1 340 0a170 170 0 1 1-340 0"/>
        </defs>
        <text>
          <textPath href="#rp">Clarity &#10022; Care &#10022; Consistency &#10022; Clarity &#10022; Care &#10022; Consistency &#10022;&#160;</textPath>
        </text>
      </svg>
    </div>
  </div>
  <div class="w vstate">
    <p class="eyebrow">Our vision</p>
    <h2 class="vq">To be among the top business process outsourcing providers &mdash; known for clarity, care and consistency.</h2>
    <p class="eyebrow eb-m">Our mission</p>
    <p class="mission">In an industry where simplifying data is the key to success, we aim to be resourceful, innovative and responsive to our clients&rsquo; needs &mdash; delivering consistent quality and helping their businesses succeed, because their success boosts our own.</p>
  </div>
</section>

<style is:global>
  .vscroll {
    height: 220svh;
  }
  .vstick {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    z-index: 1;
  }
  .vring {
    width: min(88vmin, 780px);
    aspect-ratio: 1;
    overflow: visible;
    will-change: transform;
  }
  .vring text {
    font: 800 30px var(--disp);
    fill: var(--ivory);
  }
  .vstate {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .vq {
    font: 700 clamp(1.7rem, 5.2vw, 5rem)/1.05 var(--disp);
    letter-spacing: -.04em;
    max-width: 20ch;
    text-wrap: balance;
  }
  .eb-m {
    margin-top: clamp(36px, 5vw, 56px);
    margin-bottom: 14px;
  }
  .mission {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    opacity: .72;
  }

  @media (max-width: 640px) {
    .vscroll {
      height: 170svh;
    }
    .vring {
      width: min(88vw, 420px);
    }
    .vq {
      font-size: clamp(1.65rem, 7vw, 2.6rem);
    }
    .mission {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vscroll {
      height: auto;
    }
    .vstick {
      position: relative;
      height: auto;
      padding: 4rem 0;
    }
  }
</style>
