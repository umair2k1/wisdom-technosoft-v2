---
---

<section class="vision-section junction-marker" id="vision" data-theme="ink">
  <!-- Section Meta Bar -->
  <div class="section-meta-bar">
    <div class="meta-left">
      <span class="meta-index">[03 // SPEC]</span>
      <span class="meta-tag">SYSTEM MANIFESTO &amp; PRECISION COMPASS</span>
    </div>
    <div class="meta-right">
      <span class="meta-annotation font-mono">SCROLL-TIMELINE: ROTATING SCHEMATIC</span>
    </div>
  </div>

  <div class="vision-layout">
    <!-- Left Column: Rotating Architectural Vector Schematic (Native Scroll-Driven) -->
    <div class="vision-schematic-cell border-r">
      <div class="schematic-container">
        <!-- SVG Vector Reticle Compass -->
        <svg class="reticle-svg" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Outer Compass Ring (Scroll-driven rotation) -->
          <g class="scroll-schematic-spin outer-ring">
            <circle cx="250" cy="250" r="230" stroke="rgba(244, 242, 236, 0.12)" stroke-width="1" stroke-dasharray="4 8" />
            <circle cx="250" cy="250" r="215" stroke="rgba(255, 59, 0, 0.3)" stroke-width="1" />
            <!-- Cardinal ticks -->
            <line x1="250" y1="12" x2="250" y2="35" stroke="var(--accent-signal)" stroke-width="2" />
            <line x1="250" y1="465" x2="250" y2="488" stroke="var(--accent-signal)" stroke-width="2" />
            <line x1="12" y1="250" x2="35" y2="250" stroke="var(--accent-signal)" stroke-width="2" />
            <line x1="465" y1="250" x2="488" y2="250" stroke="var(--accent-signal)" stroke-width="2" />
          </g>

          <!-- Middle Counter-Rotating Text Ring -->
          <g class="scroll-schematic-counter middle-ring">
            <circle cx="250" cy="250" r="170" stroke="rgba(200, 255, 0, 0.25)" stroke-width="1" stroke-dasharray="2 4" />
            <path id="text-ring-path" d="M 250, 250 m -150, 0 a 150,150 0 1,1 300,0 a 150,150 0 1,1 -300,0" fill="none" />
            <text fill="rgba(244, 242, 236, 0.6)" font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="0.22em">
              <textPath href="#text-ring-path">
                &bull; CLARITY IN CODE &bull; CARE IN CONVERSATIONS &bull; CONSISTENCY IN DATA &bull; ZERO SLOP
              </textPath>
            </text>
          </g>

          <!-- Inner Crosshair Grid -->
          <line x1="180" y1="250" x2="320" y2="250" stroke="rgba(255, 59, 0, 0.5)" stroke-width="1" />
          <line x1="250" y1="180" x2="250" y2="320" stroke="rgba(255, 59, 0, 0.5)" stroke-width="1" />
          <circle cx="250" cy="250" r="85" stroke="rgba(244, 242, 236, 0.2)" stroke-width="1" />
          <circle cx="250" cy="250" r="6" fill="var(--accent-signal)" />
        </svg>

        <!-- Centered Crest Emblem -->
        <div class="schematic-centerpiece">
          <img src="/assets/logo-mark-light.png" alt="Wisdom Crest" class="schematic-logo" width="56" height="46" />
          <span class="schematic-tag font-mono">EST. NAGPUR CORE</span>
        </div>
      </div>

      <div class="schematic-telemetry font-mono">
        <div class="schem-col">
          <span class="schem-lbl">ROTATION MATRIX</span>
          <span class="schem-val">CSS VIEW TIMELINE</span>
        </div>
        <div class="schem-col">
          <span class="schem-lbl">PRECISION SLA</span>
          <span class="schem-val" style="color: var(--accent-acid)">99.8% VERIFIED</span>
        </div>
      </div>
    </div>

    <!-- Right Column: System Manifesto & Mission -->
    <div class="vision-content-cell">
      <div class="vision-header-block">
        <span class="tech-tag tech-tag-acid font-mono">MANIFESTO // SENIOR DISCIPLINE</span>
        <h2 class="vision-headline">
          Engineering <span class="font-serif-italic acid-italic">rigor</span> over marketing theatrics.
        </h2>
        <p class="vision-lead">
          Most digital agencies exist to sell billable hours on reskinned templates. We exist because complex business operations require obsessive engineering discipline: zero unhandled exceptions, zero dropped customer calls, and zero dirty database records.
        </p>
      </div>

      <!-- Core Pillars Grid -->
      <div class="pillars-grid font-mono">
        <div class="pillar-box border-b border-r">
          <div class="pillar-top">
            <span class="pillar-num">[01]</span>
            <span class="pillar-title">CLARITY</span>
          </div>
          <p class="pillar-desc">
            Documented API contracts, explicit SLAs, and transparent milestone reporting. No ambiguity in deliverables.
          </p>
          <span class="pillar-tag">ZERO JARGON &bull; REAL DATA</span>
        </div>

        <div class="pillar-box border-b">
          <div class="pillar-top">
            <span class="pillar-num">[02]</span>
            <span class="pillar-title">CARE</span>
          </div>
          <p class="pillar-desc">
            Treating every customer conversation, line of code, and medical claim with the dedication of true stakeholders.
          </p>
          <span class="pillar-tag">100% AUDITED SQUADS</span>
        </div>

        <div class="pillar-box border-r">
          <div class="pillar-top">
            <span class="pillar-num">[03]</span>
            <span class="pillar-title">CONSISTENCY</span>
          </div>
          <p class="pillar-desc">
            Repeatable operational excellence with strict multi-stage quality assurance, double-blind checks, and 99.8% SLA adherence.
          </p>
          <span class="pillar-tag">DOUBLE-BLIND QA</span>
        </div>

        <div class="pillar-box">
          <div class="pillar-top">
            <span class="pillar-num">[04]</span>
            <span class="pillar-title">LONGEVITY</span>
          </div>
          <p class="pillar-desc">
            We build architectures that run quietly for years without demanding emergency refactors or ballooning technical debt.
          </p>
          <span class="pillar-tag">ZERO DEBT TARGET</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vision-section {
    background-color: var(--bg-ink);
    color: var(--text-on-ink);
    position: relative;
    border-bottom: 1px solid var(--border-ink);
  }

  .vision-layout {
    display: grid;
    grid-template-columns: 480px 1fr;
  }

  /* Left Schematic Cell */
  .vision-schematic-cell {
    padding: clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.25);
    border-right: 1px solid var(--border-ink);
  }

  .schematic-container {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reticle-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .schematic-centerpiece {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: #0B0C0E;
    padding: 16px;
    border: 1px solid var(--border-ink);
  }

  .schematic-logo {
    display: block;
    object-fit: contain;
  }

  .schematic-tag {
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--accent-acid);
  }

  .schematic-telemetry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--border-ink);
    font-size: 10px;
  }

  .schem-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .schem-lbl {
    color: var(--text-muted-ink);
  }

  .schem-val {
    font-weight: 700;
    color: #F4F2EC;
  }

  /* Right Content Cell */
  .vision-content-cell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .vision-header-block {
    padding: clamp(36px, 5vw, 64px) var(--grid-pad);
    border-bottom: 1px solid var(--border-ink);
  }

  .vision-headline {
    font-size: clamp(2.2rem, 3.8vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-top: 16px;
  }

  .acid-italic {
    color: var(--accent-acid);
  }

  .vision-lead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--text-muted-ink);
    margin-top: 20px;
    max-width: 54ch;
  }

  /* Pillars Grid: 2x2 */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .pillar-box {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--bg-surface-ink);
    transition: background 0.15s ease;
  }

  .pillar-box:hover {
    background: #181B1F;
  }

  .pillar-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pillar-num {
    color: var(--accent-signal);
    font-weight: 700;
    font-size: 12px;
  }

  .pillar-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #F4F2EC;
  }

  .pillar-desc {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-muted-ink);
  }

  .pillar-tag {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--accent-acid);
    margin-top: auto;
    padding-top: 8px;
  }

  /* Scroll-Driven Animations for SVG reticle */
  @supports (animation-timeline: view()) {
    .scroll-schematic-spin {
      transform-origin: 250px 250px;
      animation: rotate-schematic linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }

    .scroll-schematic-counter {
      transform-origin: 250px 250px;
      animation: counter-rotate-schematic linear both;
      animation-timeline: view();
      animation-range: entry 0% exit 100%;
    }
  }

  /* Responsive Matrix */
  @media (max-width: 1080px) {
    .vision-layout {
      grid-template-columns: 1fr;
    }
    .vision-schematic-cell {
      border-right: none;
      border-bottom: 1px solid var(--border-ink);
    }
  }

  @media (max-width: 640px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .pillar-box {
      border-right: none;
      border-bottom: 1px solid var(--border-ink);
    }
    .pillar-box:last-child {
      border-bottom: none;
    }
  }
</style>
