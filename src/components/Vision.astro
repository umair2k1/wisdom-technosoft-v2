---
// Wisdom Technosoft — Vision & Values Component
// CSS Scroll-Driven Logo Ghost Aperture • View-Timeline Editorial Ink-Reveal • Swiss Grid
---

<section class="vision-section s" id="vision">
  <!-- Scroll-Driven Architectural Logo Ghost Aperture -->
  <div class="vision-ghost-aperture" aria-hidden="true">
    <img src="/assets/logo-ghost.png" alt="" class="ghost-aperture-img" />
  </div>

  <div class="w vision-container">
    <!-- Header with Architectural Eyebrow -->
    <div class="vision-header">
      <div class="eyebrow-row">
        <span class="eyebrow">VISION &bull; PURPOSE &bull; ETHOS</span>
        <span class="blueprint-tag">DISCIPLINE OVER HYPE</span>
      </div>
      <h2 class="sec-title">
        Built on trust. <br />
        <span class="sec-title-accent">Driven by precision.</span>
      </h2>
      <p class="sec-subtitle">
        We reject temporary trends in favor of sustainable software architecture, empathetic voice conversations, and mathematically verifiable data pipelines.
      </p>
    </div>

    <!-- Main Architectural Grid -->
    <div class="vision-main-grid">
      
      <!-- Left: Architectural Seal / Emblem Card -->
      <div class="vision-emblem-card grid-frame">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="emblem-reticle-box">
          <svg class="emblem-rotate-ring" viewBox="0 0 320 320" aria-hidden="true">
            <defs>
              <path id="ringPath" d="M160 160m-120 0a120 120 0 1 1 240 0a120 120 0 1 1-240 0" />
            </defs>
            <circle cx="160" cy="160" r="145" class="ring-guide" />
            <circle cx="160" cy="160" r="95" class="ring-guide-inner" />
            <text class="ring-text">
              <textPath href="#ringPath">
                CLARITY IN ARCHITECTURE &bull; CARE IN VOICE &bull; CONSISTENCY IN DATA &bull;&#160;
              </textPath>
            </text>
          </svg>

          <div class="emblem-core">
            <img src="/assets/logo-mark.png" alt="Wisdom Technosoft Seal" class="emblem-mark emblem-dark" width="60" height="50" />
            <img src="/assets/logo-mark-light.png" alt="Wisdom Technosoft Seal" class="emblem-mark emblem-light" width="60" height="50" />
            <span class="emblem-loc">EST. NAGPUR</span>
          </div>
        </div>

        <div class="emblem-stats-bar">
          <div class="e-stat">
            <span class="e-val">99.8%</span>
            <span class="e-lbl">VERIFIED SLA</span>
          </div>
          <div class="e-sep"></div>
          <div class="e-stat">
            <span class="e-val">24/7/365</span>
            <span class="e-lbl">SHIFT COVERAGE</span>
          </div>
        </div>

        <p class="emblem-axiom">
          &ldquo;Simplifying complexity through disciplined engineering execution.&rdquo;
        </p>
      </div>

      <!-- Right: Manifesto Statements with Progressive Ink-Reveal -->
      <div class="vision-manifesto-col">
        
        <!-- Primary Vision Card -->
        <div class="manifesto-card grid-frame">
          <div class="crosshair crosshair-tl"></div>
          <div class="crosshair crosshair-tr"></div>
          <div class="manifesto-badge-row">
            <span class="blueprint-tag active"><span class="tag-dot"></span> OUR VISION</span>
            <span class="mono-meta">GLOBAL SCALE // HIGH RIGOR</span>
          </div>

          <h3 class="manifesto-title">
            <span class="ink-reveal-track">
              To stand among the top business process outsourcing and software development providers globally &mdash; renowned for clarity, care, and consistency.
            </span>
          </h3>

          <p class="manifesto-body">
            We envision a standard of service where technical depth and human dedication merge seamlessly. Whether deploying zero-downtime web applications or managing high-volume medical claims, our engineers and specialists take direct ownership of measurable business outcomes.
          </p>

          <div class="manifesto-metrics-row">
            <div class="m-metric">
              <span class="m-num">100%</span>
              <span class="m-txt">Milestone Reliability Target</span>
            </div>
            <div class="m-metric">
              <span class="m-num">98.7%</span>
              <span class="m-txt">First-Pass Clean Claims Rate</span>
            </div>
          </div>
        </div>

        <!-- Mission Card -->
        <div class="mission-card grid-frame">
          <div class="crosshair crosshair-bl"></div>
          <div class="crosshair crosshair-br"></div>
          <div class="manifesto-badge-row">
            <span class="blueprint-tag">OUR MISSION</span>
            <span class="mono-meta">OPERATIONAL SYMBIOSIS</span>
          </div>

          <p class="mission-prose">
            <span class="ink-reveal-track">
              In an industry where simplifying data and scaling operations are key to modern enterprise success, we provide resourceful software, high-touch voice solutions, and error-free data management &mdash; helping client businesses flourish, because their enduring success boosts our own.
            </span>
          </p>
        </div>

      </div>

    </div>

    <!-- 3 Core Pillars: Swiss-Grid Trivariate -->
    <div class="values-triad">
      
      <!-- Pillar 1: Clarity -->
      <div class="value-card grid-frame scroll-3d-card">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="value-top">
          <span class="value-num">01 // VALUE</span>
          <span class="value-status">ENFORCED</span>
        </div>
        <h4 class="value-name">Clarity</h4>
        <p class="value-desc">
          Transparent communication, predictable milestones, documented metrics, and zero ambiguity in deliverables or codebase schemas.
        </p>
        <div class="value-foot">
          <span class="value-pill">Predictable Sprints</span>
          <span class="value-pill">Documented SOPs</span>
        </div>
      </div>

      <!-- Pillar 2: Care -->
      <div class="value-card grid-frame scroll-3d-card">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="value-top">
          <span class="value-num">02 // VALUE</span>
          <span class="value-status">ENFORCED</span>
        </div>
        <h4 class="value-name">Care</h4>
        <p class="value-desc">
          Treating every customer conversation, line of code, and medical claim with the genuine dedication of invested company stakeholders.
        </p>
        <div class="value-foot">
          <span class="value-pill">Active Listening</span>
          <span class="value-pill">Defensive Code</span>
        </div>
      </div>

      <!-- Pillar 3: Consistency -->
      <div class="value-card grid-frame scroll-3d-card">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="value-top">
          <span class="value-num">03 // VALUE</span>
          <span class="value-status">ENFORCED</span>
        </div>
        <h4 class="value-name">Consistency</h4>
        <p class="value-desc">
          Repeatable operational excellence with strict multi-stage quality assurance, double-blind checks, and unbroken 99.8% SLA adherence.
        </p>
        <div class="value-foot">
          <span class="value-pill">99.8% Precision</span>
          <span class="value-pill">24/7 Handover</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .vision-section {
    position: relative;
    padding-block: clamp(80px, 12vh, 140px);
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  /* Scroll-Driven Logo Ghost Aperture */
  .vision-ghost-aperture {
    position: absolute;
    top: 15%;
    right: -8vw;
    width: clamp(400px, 45vw, 750px);
    pointer-events: none;
    z-index: 0;
    opacity: 0.08;
    will-change: transform, opacity;
  }

  .ghost-aperture-img {
    width: 100%;
    height: auto;
    display: block;
    transform-origin: center center;
  }

  @supports (animation-timeline: scroll(root)) {
    .ghost-aperture-img {
      animation: ghost-aperture-spin linear both;
      animation-timeline: scroll(root);
    }

    @keyframes ghost-aperture-spin {
      from {
        transform: rotate(-30deg) scale(0.9);
      }
      to {
        transform: rotate(50deg) scale(1.3);
      }
    }
  }

  .vision-container {
    position: relative;
    z-index: 2;
  }

  .vision-header {
    margin-bottom: 56px;
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .sec-title-accent {
    color: var(--accent);
  }

  .vision-main-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
    margin-bottom: 32px;
  }

  /* Left Emblem Card */
  .vision-emblem-card {
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
  }

  .emblem-reticle-box {
    position: relative;
    width: 260px;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .emblem-rotate-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: slow-rotate 60s linear infinite;
  }

  @keyframes slow-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .ring-guide,
  .ring-guide-inner {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .ring-text {
    font-family: var(--mono);
    font-size: 8.5px;
    fill: var(--ink-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .emblem-core {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .emblem-mark {
    width: 54px;
    height: auto;
  }
  .emblem-light { display: none; }
  .emblem-dark { display: block; }
  [data-theme="blueprint"] .emblem-light,
  .theme-blueprint .emblem-light { display: block; }
  [data-theme="blueprint"] .emblem-dark,
  .theme-blueprint .emblem-dark { display: none; }

  .emblem-loc {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 700;
  }

  .emblem-stats-bar {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    margin-bottom: 20px;
  }

  .e-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .e-val {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
  }

  .e-lbl {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }

  .e-sep {
    width: 1px;
    height: 24px;
    background: var(--border-strong);
  }

  .emblem-axiom {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-muted);
    font-style: italic;
  }

  /* Right Manifesto Col */
  .vision-manifesto-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .manifesto-card,
  .mission-card {
    padding: 36px;
  }

  .manifesto-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .mono-meta {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }

  .manifesto-title {
    font-family: var(--disp);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }

  .manifesto-body {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: 28px;
  }

  .manifesto-metrics-row {
    display: flex;
    gap: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .m-metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .m-num {
    font-family: var(--mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--accent);
  }

  .m-txt {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mission-prose {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* Values Triad */
  .values-triad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .value-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .value-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    font-family: var(--mono);
    font-size: 10px;
  }

  .value-num {
    color: var(--accent);
    font-weight: 700;
  }

  .value-status {
    color: var(--ink-muted);
    border: 1px solid var(--border);
    padding: 1px 5px;
    background: var(--surface);
  }

  .value-name {
    font-family: var(--disp);
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .value-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: 20px;
  }

  .value-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .value-pill {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 3px 8px;
  }

  @media (max-width: 960px) {
    .vision-main-grid {
      grid-template-columns: 1fr;
    }
    .values-triad {
      grid-template-columns: 1fr;
    }
  }
</style>
