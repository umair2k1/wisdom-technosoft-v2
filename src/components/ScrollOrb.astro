<div class="orb" aria-hidden="true">
  <svg viewBox="-150 -150 300 300">
    <circle class="o-ring" r="135"/>
    <image href="/assets/logo-ghost.png" xlink:href="/assets/logo-ghost.png" x="-100" y="-81.25" width="200" height="162.5"/>
  </svg>
</div>
<div class="bar" aria-hidden="true"><i></i></div>

<style is:global>
  .orb {
    position: fixed;
    right: -5vw;
    top: 20vh;
    width: min(52vmin, 560px);
    height: min(52vmin, 560px);
    aspect-ratio: 1;
    z-index: 0;
    pointer-events: none;
    opacity: 0.14;
    transition: opacity 0.5s ease;
    will-change: transform;
  }
  .orb svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .o-ring {
    fill: none;
    stroke: var(--tan, #C9A27E);
    stroke-width: 1.5;
    stroke-dasharray: 4px 8px;
    opacity: 0.6;
  }
  .bar {
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    z-index: 210;
    pointer-events: none;
    background: rgba(244, 240, 232, 0.05);
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--tan);
    transform: scaleY(0);
    transform-origin: 50% 0;
  }
  body:not(.has-orb) .bar,
  body:not(.has-orb) .orb {
    display: none;
  }
  @media (max-width: 768px), (max-height: 680px) {
    .orb {
      display: none;
    }
  }
</style>
