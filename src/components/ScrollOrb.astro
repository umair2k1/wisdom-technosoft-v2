---

<div class="orb" aria-hidden="true">
  <svg viewBox="-150 -150 300 300">
    <circle class="o-ring" r="135"/>
    <image href="/assets/logo-ghost.png" x="-100" y="-81.25" width="200" height="162.5"/>
  </svg>
</div>
<div class="bar" aria-hidden="true"><i></i></div>
<p class="chap" aria-hidden="true" id="chap">Welcome</p>

<style is:global>
  .orb {
    position: fixed;
    left: 50%;
    top: 50%;
    width: min(62vmin, 640px);
    height: min(62vmin, 640px);
    aspect-ratio: 1;
    margin: calc(min(62vmin, 640px) / -2) 0 0 calc(min(62vmin, 640px) / -2);
    z-index: 0;
    pointer-events: none;
    perspective: 900px;
    opacity: 0;
    will-change: transform, opacity;
  }
  .orb svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    will-change: transform;
  }
  .o-ring {
    fill: none;
    stroke: var(--ac, #C9A27E);
    stroke-width: 1.2;
    stroke-dasharray: calc(1.5px + var(--sp, 0) * 5px) 7px;
    opacity: .7;
  }
  .bar {
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--tan);
    transform: scaleY(0);
    transform-origin: 50% 0;
  }
  .chap {
    position: fixed;
    left: var(--g);
    bottom: 20px;
    z-index: 150;
    font-size: 13px;
    font-weight: 500;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
    text-shadow: 0 0 12px rgba(0, 0, 0, .45);
  }
  body:not(.has-orb) .chap,
  body:not(.has-orb) .bar {
    display: none;
  }
  @media (max-width: 640px), (max-height: 680px) {
    .chap {
      display: none;
    }
  }
</style>
