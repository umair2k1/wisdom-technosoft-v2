---
---

<!-- Ambient Atmospheric Background -->
<div class="ambient-backdrop" aria-hidden="true">
  <div class="ambient-glow glow-1"></div>
  <div class="ambient-glow glow-2"></div>
</div>

<!-- Scroll Progress Edge Bar -->
<div class="scroll-progress-bar" aria-hidden="true"></div>

<style is:global>
  .ambient-backdrop {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.12;
    pointer-events: none;
  }
  .glow-1 {
    width: min(60vw, 600px);
    height: min(60vw, 600px);
    top: -10vw;
    right: -10vw;
    background: radial-gradient(circle, var(--tan) 0%, transparent 70%);
  }
  .glow-2 {
    width: min(50vw, 500px);
    height: min(50vw, 500px);
    bottom: 10vh;
    left: -10vw;
    background: radial-gradient(circle, rgba(6, 51, 64, 0.8) 0%, transparent 70%);
  }

  .scroll-progress-bar {
    position: fixed;
    top: 0;
    right: 0;
    width: 3px;
    height: 100vh;
    transform-origin: top;
    background: linear-gradient(180deg, var(--tan) 0%, #D9B48F 100%);
    z-index: 100;
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .scroll-progress-bar {
      animation: progress-grow linear;
      animation-timeline: scroll();
    }
    @keyframes progress-grow {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }
  }
  @media (max-width: 900px) {
    .scroll-progress-bar {
      display: none;
    }
  }
</style>
