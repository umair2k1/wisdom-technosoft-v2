---
// Wisdom Technosoft — Team & Leadership Component
// 3D Perspective Card Compression (animation-timeline: view()) • Swiss Grid Architectural Frame
---

<section class="team-section s" id="team">
  <div class="w team-container">
    
    <!-- Section Header -->
    <div class="team-header">
      <div class="header-left">
        <div class="eyebrow-row">
          <span class="eyebrow">LEADERSHIP &bull; GOVERNANCE &bull; TALENT</span>
          <span class="blueprint-tag">ORGANIZATIONAL ROSTER</span>
        </div>
        <h2 class="sec-title">
          The people behind <br />
          <span class="text-orange">the engineering.</span>
        </h2>
      </div>
      <p class="sec-subtitle">
        A senior multidisciplinary team spanning software architecture, voice operations, and compliance QA &mdash; operating as one unified unit to deliver measurable client value.
      </p>
    </div>

    <!-- 4 Leadership Division Cards in 3D View-Timeline Grid -->
    <div class="team-grid">
      
      <!-- 01 Executive Leadership -->
      <article class="team-card grid-frame scroll-3d-card">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="team-card-head">
          <span class="unit-code">DIV // 01</span>
          <span class="role-badge">Managing Director</span>
        </div>

        <div class="team-card-body">
          <h3 class="team-division">Executive Leadership</h3>
          <p class="division-domain">Strategy, Vision &amp; Governance</p>
          <p class="division-desc">
            Directs long-term corporate direction, technology investments, and client governance to ensure enduring partnerships and enterprise scale.
          </p>

          <div class="division-meter-row">
            <div class="meter-labels">
              <span class="meter-lbl">Governance &amp; Strategy</span>
              <span class="meter-val">100%</span>
            </div>
            <div class="meter-track"><div class="meter-fill" style="width: 100%"></div></div>
          </div>
        </div>

        <div class="division-tags">
          <span class="d-tag">Enterprise Strategy</span>
          <span class="d-tag">Governance</span>
          <span class="d-tag">Global Growth</span>
        </div>
      </article>

      <!-- 02 Operations & Delivery -->
      <article class="team-card grid-frame scroll-3d-card">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="team-card-head">
          <span class="unit-code">DIV // 02</span>
          <span class="role-badge">Managing Director</span>
        </div>

        <div class="team-card-body">
          <h3 class="team-division">Operations &amp; Delivery</h3>
          <p class="division-domain">Execution &amp; Operational Scale</p>
          <p class="division-desc">
            Leads 24/7 delivery pipelines, telecalling campaigns, workforce scheduling, and resource allocation to maintain uninterrupted service excellence.
          </p>

          <div class="division-meter-row">
            <div class="meter-labels">
              <span class="meter-lbl">24/7 SLA Adherence</span>
              <span class="meter-val">99.8%</span>
            </div>
            <div class="meter-track"><div class="meter-fill" style="width: 99.8%"></div></div>
          </div>
        </div>

        <div class="division-tags">
          <span class="d-tag">24/7 Shifts</span>
          <span class="d-tag">SLA Adherence</span>
          <span class="d-tag">Scale Operations</span>
        </div>
      </article>

      <!-- 03 Process & Quality -->
      <article class="team-card grid-frame scroll-3d-card">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="team-card-head">
          <span class="unit-code">DIV // 03</span>
          <span class="role-badge">Consultant</span>
        </div>

        <div class="team-card-body">
          <h3 class="team-division">Process &amp; Quality</h3>
          <p class="division-domain">Audits, Compliance &amp; Standards</p>
          <p class="division-desc">
            Designs and enforces stringent standard operating procedures, multi-tier double-blind data verification, and compliance-driven healthcare QA protocols.
          </p>

          <div class="division-meter-row">
            <div class="meter-labels">
              <span class="meter-lbl">Audit &amp; Compliance Accuracy</span>
              <span class="meter-val">99.9%</span>
            </div>
            <div class="meter-track"><div class="meter-fill" style="width: 99.9%"></div></div>
          </div>
        </div>

        <div class="division-tags">
          <span class="d-tag">Quality Audits</span>
          <span class="d-tag">HIPAA Standards</span>
          <span class="d-tag">Process SOPs</span>
        </div>
      </article>

      <!-- 04 Client Partnerships -->
      <article class="team-card grid-frame scroll-3d-card">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="team-card-head">
          <span class="unit-code">DIV // 04</span>
          <span class="role-badge">Consultant</span>
        </div>

        <div class="team-card-body">
          <h3 class="team-division">Client Partnerships</h3>
          <p class="division-domain">Relationship &amp; Account Success</p>
          <p class="division-desc">
            Acts as the primary consultative bridge between client stakeholder goals and delivery milestones, maintaining absolute project transparency.
          </p>

          <div class="division-meter-row">
            <div class="meter-labels">
              <span class="meter-lbl">Client Retention &amp; CSAT</span>
              <span class="meter-val">98%</span>
            </div>
            <div class="meter-track"><div class="meter-fill" style="width: 98%"></div></div>
          </div>
        </div>

        <div class="division-tags">
          <span class="d-tag">Account Success</span>
          <span class="d-tag">Consultative Scoping</span>
          <span class="d-tag">Reporting</span>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .team-section {
    position: relative;
    padding-block: clamp(80px, 12vh, 140px);
    background-color: var(--bg);
    color: var(--ink);
    border-bottom: 1px solid var(--border);
  }

  .team-header {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 32px;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .text-orange {
    color: var(--accent);
  }

  /* 3D View-Timeline Card Grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    perspective: 1000px;
  }

  .team-card {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s var(--ease), border-color 0.25s ease;
    transform-origin: center bottom;
  }

  .team-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .team-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    font-family: var(--mono);
  }

  .unit-code {
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
  }

  .role-badge {
    font-size: 9.5px;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    padding: 2px 6px;
    background: var(--surface);
  }

  .team-division {
    font-family: var(--disp);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }

  .division-domain {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .division-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: 24px;
  }

  .division-meter-row {
    margin-bottom: 24px;
  }

  .meter-labels {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink-muted);
    margin-bottom: 6px;
  }

  .meter-val {
    color: var(--ink);
    font-weight: 700;
  }

  .meter-track {
    width: 100%;
    height: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .meter-fill {
    height: 100%;
    background: var(--accent);
  }

  .division-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .d-tag {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-muted);
    padding: 2px 6px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  @media (max-width: 1100px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .team-header {
      grid-template-columns: 1fr;
    }
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
