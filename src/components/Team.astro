---
---

<section class="team-section junction-marker" id="team" data-theme="paper">
  <!-- Section Meta Bar -->
  <div class="section-meta-bar">
    <div class="meta-left">
      <span class="meta-index">[04 // DIVISION]</span>
      <span class="meta-tag">OPERATIONAL GOVERNANCE &bull; DIVISION LEADS</span>
    </div>
    <div class="meta-right">
      <span class="meta-annotation font-mono">SENIOR OWNERSHIP &bull; ZERO OFFSHORE RUNAROUND</span>
    </div>
  </div>

  <div class="team-intro">
    <div class="intro-left">
      <span class="tech-tag tech-tag-signal font-mono">GOVERNANCE // DIRECT ACCOUNTABILITY</span>
      <h2 class="team-headline">
        The people who take <span class="font-serif-italic signal-italic">responsibility</span> when systems are live.
      </h2>
    </div>
    <p class="team-subtitle">
      A senior multidisciplinary leadership team across software architecture, continuous 24/7 voice delivery, data engineering, and healthcare compliance &mdash; working as one accountable unit.
    </p>
  </div>

  <!-- 4 Division Units Grid -->
  <div class="team-grid">
    <!-- Division 01 -->
    <article class="team-card scroll-view-reveal border-b border-r">
      <div class="team-card-header font-mono">
        <span class="unit-code">[DIV-01]</span>
        <span class="role-badge">MANAGING DIRECTOR</span>
      </div>
      <div class="team-card-body">
        <h3 class="division-title">Systems Architecture &amp; Governance</h3>
        <span class="division-domain font-mono">Strategy &bull; Cloud Infrastructure &bull; SOW SLAs</span>
        <p class="division-desc">
          Directs software engineering architecture, strategic technology investments, and client governance. Ensures system designs meet strict enterprise uptime and scalability standards.
        </p>
        <div class="division-specs font-mono">
          <div class="spec-line"><span class="spec-dot"></span> Cloud Architecture &amp; Edge Systems</div>
          <div class="spec-line"><span class="spec-dot"></span> Contractual SLA Governance</div>
          <div class="spec-line"><span class="spec-dot"></span> Zero-Regression Release Standards</div>
        </div>
      </div>
      <div class="team-card-footer font-mono">
        <span class="footer-lbl">SLA INTEGRITY:</span>
        <span class="footer-val">100% ENFORCED</span>
      </div>
    </article>

    <!-- Division 02 -->
    <article class="team-card scroll-view-reveal border-b border-r">
      <div class="team-card-header font-mono">
        <span class="unit-code">[DIV-02]</span>
        <span class="role-badge">MANAGING DIRECTOR</span>
      </div>
      <div class="team-card-body">
        <h3 class="division-title">Operations &amp; 24/7 Delivery Squads</h3>
        <span class="division-domain font-mono">Workforce Management &bull; Voice Queues &bull; Scale</span>
        <p class="division-desc">
          Leads round-the-clock delivery pipelines, telecalling campaigns, workforce allocation, and supervisor QA. Enforces continuous 24/7 shift coverage across US and Indian timezones.
        </p>
        <div class="division-specs font-mono">
          <div class="spec-line"><span class="spec-dot"></span> 24/7/365 Shift Operations</div>
          <div class="spec-line"><span class="spec-dot"></span> Real-time Call QA Monitoring</div>
          <div class="spec-line"><span class="spec-dot"></span> High-Capacity Workforce Scaling</div>
        </div>
      </div>
      <div class="team-card-footer font-mono">
        <span class="footer-lbl">CALL QA TARGET:</span>
        <span class="footer-val">99.2% VERIFIED</span>
      </div>
    </article>

    <!-- Division 03 -->
    <article class="team-card scroll-view-reveal border-b border-r">
      <div class="team-card-header font-mono">
        <span class="unit-code">[DIV-03]</span>
        <span class="role-badge">LEAD CONSULTANT</span>
      </div>
      <div class="team-card-body">
        <h3 class="division-title">Process Audit &amp; Quality Assurance</h3>
        <span class="division-domain font-mono">Double-Blind Verification &bull; HIPAA &bull; Compliance</span>
        <p class="division-desc">
          Designs and enforces standard operating procedures, multi-tier double-blind data audits, and HIPAA-compliant healthcare billing and coding QA protocols.
        </p>
        <div class="division-specs font-mono">
          <div class="spec-line"><span class="spec-dot"></span> Double-Blind Data Entry Auditing</div>
          <div class="spec-line"><span class="spec-dot"></span> HIPAA &amp; HITECH Regulatory QA</div>
          <div class="spec-line"><span class="spec-dot"></span> Systematic Defect Elimination</div>
        </div>
      </div>
      <div class="team-card-footer font-mono">
        <span class="footer-lbl">AUDIT PRECISION:</span>
        <span class="footer-val">99.8% VERIFIED</span>
      </div>
    </article>

    <!-- Division 04 -->
    <article class="team-card scroll-view-reveal border-b">
      <div class="team-card-header font-mono">
        <span class="unit-code">[DIV-04]</span>
        <span class="role-badge">LEAD CONSULTANT</span>
      </div>
      <div class="team-card-body">
        <h3 class="division-title">Client Partnerships &amp; Milestone Scoping</h3>
        <span class="division-domain font-mono">Stakeholder Access &bull; Scoping &bull; Delivery</span>
        <p class="division-desc">
          Acts as the direct consultative bridge between client stakeholder goals and delivery milestones. Maintains total project transparency with zero layers of bureaucratic lag.
        </p>
        <div class="division-specs font-mono">
          <div class="spec-line"><span class="spec-dot"></span> Direct Stakeholder Communication</div>
          <div class="spec-line"><span class="spec-dot"></span> Transparent SOW Milestone Tracking</div>
          <div class="spec-line"><span class="spec-dot"></span> Multi-Year Account Retention</div>
        </div>
      </div>
      <div class="team-card-footer font-mono">
        <span class="footer-lbl">CLIENT CSAT:</span>
        <span class="footer-val">98% SATISFACTION</span>
      </div>
    </article>
  </div>
</section>

<style>
  .team-section {
    background-color: var(--bg-paper);
    color: var(--text-primary);
    position: relative;
    border-bottom: 1px solid var(--border-paper);
  }

  .team-intro {
    padding: clamp(40px, 6vw, 72px) var(--grid-pad);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    align-items: end;
    border-bottom: 1px solid var(--border-paper);
  }

  .team-headline {
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-top: 16px;
  }

  .signal-italic {
    color: var(--accent-signal);
  }

  .team-subtitle {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 48ch;
  }

  /* 4-Column Division Grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .team-card {
    background: var(--bg-paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background-color 0.2s ease;
  }

  .team-card:hover {
    background: var(--bg-surface);
  }

  .team-card:last-child {
    border-right: none;
  }

  .team-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border-paper);
    background: rgba(0, 0, 0, 0.02);
  }

  .unit-code {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-signal);
  }

  .role-badge {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .team-card-body {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .division-title {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .division-domain {
    font-size: 11px;
    color: var(--accent-signal);
    letter-spacing: 0.04em;
  }

  .division-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .division-specs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 11px;
    color: var(--text-primary);
    margin-top: auto;
    padding-top: 16px;
  }

  .spec-line {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spec-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--accent-signal);
  }

  .team-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-top: 1px solid var(--border-paper);
    background: rgba(0, 0, 0, 0.02);
    font-size: 10px;
  }

  .footer-lbl {
    color: var(--text-muted);
  }

  .footer-val {
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Responsive Matrix */
  @media (max-width: 1120px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .team-card:nth-child(2) {
      border-right: none;
    }
  }

  @media (max-width: 768px) {
    .team-intro {
      grid-template-columns: 1fr;
    }
    .team-grid {
      grid-template-columns: 1fr;
    }
    .team-card {
      border-right: none;
    }
  }
</style>
