---
---

<section class="s services-section" id="services" style="--bg:var(--teal);--fg:var(--ivory)">
  <div class="w services-container">
    <div class="services-header">
      <div class="header-left">
        <p class="eyebrow" data-scramble="What We Do • Core Capabilities">What We Do &bull; Core Capabilities</p>
        <h2 class="services-title" data-scramble="Precision engineering & operational scale.">Precision engineering &amp; operational scale.</h2>
      </div>
      <p class="services-subtitle">
        From custom software engineering to high-touch voice calling, clean data processing, and US medical billing &mdash; we power the operations behind growing enterprises.
      </p>
    </div>

    <!-- Fluid Filter Tabs -->
    <div class="services-filter" role="tablist" aria-label="Filter services">
      <button class="filter-tab is-active magnetic" data-filter="all" role="tab" aria-selected="true">
        All Capabilities <span class="tab-count">5</span>
      </button>
      <button class="filter-tab magnetic" data-filter="software" role="tab" aria-selected="false">
        Software Engineering <span class="tab-count">1</span>
      </button>
      <button class="filter-tab magnetic" data-filter="telecalling" role="tab" aria-selected="false">
        Voice &amp; Telecalling <span class="tab-count">1</span>
      </button>
      <button class="filter-tab magnetic" data-filter="data" role="tab" aria-selected="false">
        Data Operations <span class="tab-count">1</span>
      </button>
      <button class="filter-tab magnetic" data-filter="bpo" role="tab" aria-selected="false">
        Business Process <span class="tab-count">1</span>
      </button>
      <button class="filter-tab magnetic" data-filter="healthcare" role="tab" aria-selected="false">
        Healthcare &amp; RCM <span class="tab-count">1</span>
      </button>
    </div>

    <div class="services-grid" id="services-grid">
      <!-- 1. Software Development -->
      <article class="service-card tilt-card featured" data-category="software">
        <div class="card-top">
          <div class="card-icon software-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <span class="card-cat-badge">Engineering &amp; Cloud</span>
        </div>
        
        <div class="card-body">
          <h3 class="card-title">Software Development</h3>
          <p class="card-desc">
            High-quality, user-friendly, and scalable software built around your exact business requirements &mdash; web platforms, mobile applications, internal administrative tools, and automated cloud workflows.
          </p>

          <div class="card-highlights">
            <span class="hl-label">Key Capabilities</span>
            <ul class="hl-list">
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Custom Web &amp; SaaS Platforms (Astro, React, Node)</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Native &amp; Cross-Platform Mobile Apps (iOS &amp; Android)</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Enterprise Dashboards &amp; Automated Microservices</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Cloud Edge Infrastructure &amp; API Integrations</li>
            </ul>
          </div>

          <!-- Interactive Architecture Accordion -->
          <div class="flow-accordion">
            <button class="flow-toggle" aria-expanded="false">
              <span class="flow-toggle-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Inspect System Architecture Flow</span>
              </span>
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="flow-content" aria-hidden="true">
              <div class="flow-diagram">
                <div class="flow-step">
                  <span class="step-num">01</span>
                  <span class="step-title">Client Layer</span>
                  <span class="step-desc">Web &amp; Mobile UI</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step active">
                  <span class="step-num">02</span>
                  <span class="step-title">Edge Gateway</span>
                  <span class="step-desc">Auth &amp; Cloudflare</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">03</span>
                  <span class="step-title">Cluster API</span>
                  <span class="step-desc">Node Microservices</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">04</span>
                  <span class="step-title">Database</span>
                  <span class="step-desc">Postgres / Redis</span>
                </div>
              </div>
            </div>
          </div>

          <div class="card-foot">
            <ul class="tags">
              <li>Web Platforms</li>
              <li>Mobile Apps</li>
              <li>Custom APIs</li>
              <li>Automation</li>
            </ul>
            <a href="#contact" class="card-action magnetic" data-service-select="Software Development">
              <span>Discuss software</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- 2. Telecalling Services -->
      <article class="service-card tilt-card featured" data-category="telecalling">
        <div class="card-top">
          <div class="card-icon voice-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <span class="card-cat-badge">Customer &amp; B2B Voice</span>
        </div>

        <div class="card-body">
          <h3 class="card-title">Telecalling Services</h3>
          <p class="card-desc">
            Courteous, result-oriented conversations that strengthen customer relationships, qualify leads, and drive business growth in English, Hindi, and regional languages with dedicated caller squads.
          </p>

          <div class="card-highlights">
            <span class="hl-label">Key Capabilities</span>
            <ul class="hl-list">
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> B2B Outbound Lead Qualification Campaigns</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Inbound Customer Support &amp; Technical Helpdesk</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Multilingual Calling (English, Hindi, Marathi squads)</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Real-time CRM Sync &amp; Sentiment Disposition</li>
            </ul>
          </div>

          <!-- Interactive Flow Accordion -->
          <div class="flow-accordion">
            <button class="flow-toggle" aria-expanded="false">
              <span class="flow-toggle-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>Inspect Call Routing &amp; QA Tree</span>
              </span>
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="flow-content" aria-hidden="true">
              <div class="flow-diagram">
                <div class="flow-step">
                  <span class="step-num">01</span>
                  <span class="step-title">Campaign Ingest</span>
                  <span class="step-desc">Target List &amp; CRM</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step active">
                  <span class="step-num">02</span>
                  <span class="step-title">Nagpur Caller</span>
                  <span class="step-desc">Scripted / Dynamic</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">03</span>
                  <span class="step-title">Whisper QA</span>
                  <span class="step-desc">Live Supervision</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">04</span>
                  <span class="step-title">Disposition</span>
                  <span class="step-desc">CRM Instant Sync</span>
                </div>
              </div>
            </div>
          </div>

          <div class="card-foot">
            <ul class="tags">
              <li>B2B Campaigns</li>
              <li>Lead Generation</li>
              <li>Multilingual</li>
              <li>CRM Integration</li>
            </ul>
            <a href="#contact" class="card-action magnetic" data-service-select="Telecalling Services">
              <span>Discuss telecalling</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- 3. Data Entry & Management -->
      <article class="service-card tilt-card" data-category="data">
        <div class="card-top">
          <div class="card-icon data-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
          </div>
          <span class="card-cat-badge">Accuracy &amp; Verification</span>
        </div>

        <div class="card-body">
          <h3 class="card-title">Data Entry &amp; Management</h3>
          <p class="card-desc">
            Precise, timely data services that keep your business records clean, structured, and audit-ready with multi-tier verification and 99.8% documented accuracy benchmarks.
          </p>

          <div class="card-highlights">
            <span class="hl-label">Key Capabilities</span>
            <ul class="hl-list">
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> High-Volume Data Entry &amp; Normalization</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Document Digitization &amp; Extraction QA</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Catalog, Inventory &amp; Records Cleansing</li>
            </ul>
          </div>

          <!-- Interactive Flow Accordion -->
          <div class="flow-accordion">
            <button class="flow-toggle" aria-expanded="false">
              <span class="flow-toggle-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                <span>Inspect ETL Data Cleansing Flow</span>
              </span>
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="flow-content" aria-hidden="true">
              <div class="flow-diagram">
                <div class="flow-step">
                  <span class="step-num">01</span>
                  <span class="step-title">Raw Intake</span>
                  <span class="step-desc">PDFs / CSV / OCR</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step active">
                  <span class="step-num">02</span>
                  <span class="step-title">Deduplication</span>
                  <span class="step-desc">Fuzzy Matching</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">03</span>
                  <span class="step-title">Human QA</span>
                  <span class="step-desc">99.8% Verification</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">04</span>
                  <span class="step-title">Clean Lake</span>
                  <span class="step-desc">Structured Output</span>
                </div>
              </div>
            </div>
          </div>

          <div class="card-foot">
            <ul class="tags">
              <li>Data Entry</li>
              <li>QA Audits</li>
              <li>Digitization</li>
              <li>Analytics</li>
            </ul>
            <a href="#contact" class="card-action magnetic" data-service-select="Data Entry & Management">
              <span>Discuss data</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- 4. Business Process & Industrial Solutions -->
      <article class="service-card tilt-card" data-category="bpo">
        <div class="card-top">
          <div class="card-icon bpo-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <span class="card-cat-badge">Operational Workflows</span>
        </div>

        <div class="card-body">
          <h3 class="card-title">Business Process &amp; Industrial Solutions</h3>
          <p class="card-desc">
            End-to-end BPO and operational support &mdash; supply-chain workflows on SAP, e-commerce catalog management, and specialized industrial process support (STP, ETP, chemical machinery, instrumentation).
          </p>

          <div class="card-highlights">
            <span class="hl-label">Key Capabilities</span>
            <ul class="hl-list">
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> SAP &amp; Supply Chain Process Execution</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> E-Commerce Operations &amp; Web Store Builds</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Industrial Instrumentation &amp; Water Systems (STP/ETP)</li>
            </ul>
          </div>

          <div class="card-foot">
            <ul class="tags">
              <li>BPO Operations</li>
              <li>SAP / SCM</li>
              <li>E-Commerce</li>
              <li>Industrial Support</li>
            </ul>
            <a href="#contact" class="card-action magnetic" data-service-select="Business Process & Industrial Solutions">
              <span>Discuss BPO</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>

      <!-- 5. Healthcare Support & US Medical Billing (Full Width Spotlight) -->
      <article class="service-card tilt-card" data-category="healthcare">
        <div class="card-top">
          <div class="card-icon health-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 9v6"/><path d="M9 12h6"/></svg>
          </div>
          <span class="card-cat-badge">Revenue Cycle &amp; HIPAA</span>
        </div>

        <div class="card-body">
          <h3 class="card-title">Healthcare Support &amp; US Medical Billing</h3>
          <p class="card-desc">
            Accurate, compliant back-office support for healthcare practices &mdash; including US medical billing, claims preparation, denial resolution, and revenue cycle management with documented audit trails and 98.7% clean claim submission rate.
          </p>

          <div class="card-highlights">
            <span class="hl-label">Key Capabilities</span>
            <ul class="hl-list">
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Accurate US Medical Claims Scrubbing &amp; Submission (CMS-1500 &amp; UB-04)</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Denial Management, Root-Cause Auditing &amp; Payer Appeals</li>
              <li><svg class="check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Payment Posting, ERA 835 Reconciliation &amp; AR Days Reduction</li>
            </ul>
          </div>

          <!-- Interactive Flow Accordion -->
          <div class="flow-accordion">
            <button class="flow-toggle" aria-expanded="false">
              <span class="flow-toggle-text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 9v6"/><path d="M9 12h6"/></svg>
                <span>Inspect US Medical Billing &amp; EDI Claim Lifecycle</span>
              </span>
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="flow-content" aria-hidden="true">
              <div class="flow-diagram">
                <div class="flow-step">
                  <span class="step-num">01</span>
                  <span class="step-title">Encounter Intake</span>
                  <span class="step-desc">EHR / Superbill</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step active">
                  <span class="step-num">02</span>
                  <span class="step-title">Coding &amp; Scrub</span>
                  <span class="step-desc">CPT / ICD-10 QA</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">03</span>
                  <span class="step-title">EDI 837 Batch</span>
                  <span class="step-desc">Clearinghouse Send</span>
                </div>
                <div class="flow-connector"><span>&rarr;</span></div>
                <div class="flow-step">
                  <span class="step-num">04</span>
                  <span class="step-title">ERA 835 Posting</span>
                  <span class="step-desc">AR Reconciliation</span>
                </div>
              </div>
            </div>
          </div>

          <div class="card-foot">
            <ul class="tags">
              <li>US Medical Billing</li>
              <li>Claims Support</li>
              <li>Revenue Cycle</li>
              <li>Compliance QA</li>
            </ul>
            <a href="#contact" class="card-action magnetic" data-service-select="Healthcare Support / US Medical Billing">
