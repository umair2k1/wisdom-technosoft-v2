---
---

<section class="services-section junction-marker" id="services" data-theme="ink">
  <!-- Section Meta Bar -->
  <div class="section-meta-bar">
    <div class="meta-left">
      <span class="meta-index">[01 // CAPABILITIES]</span>
      <span class="meta-tag">CORE ENGINEERING &amp; OPERATIONAL SPECIFICATIONS</span>
    </div>
    <div class="meta-right">
      <span class="meta-annotation font-mono">FIVE PRODUCTION DISCIPLINES // 0% SLOP</span>
    </div>
  </div>

  <div class="services-intro">
    <div class="intro-left">
      <span class="tech-tag tech-tag-acid font-mono">SPECIFIED &bull; TESTED &bull; MAINTAINED</span>
      <h2 class="services-headline">
        We build systems that don’t need <span class="font-serif-italic acid-italic">emergency</span> weekend rewrites.
      </h2>
    </div>
    <p class="services-subtitle">
      Most digital vendors hand over unmaintainable codebases or churn-heavy support lines. We engineer end-to-end operational pipelines with documented SLAs, strict double-blind QA, and zero hand-waving.
    </p>
  </div>

  <!-- Blueprint Grid of 5 Core Capabilities -->
  <div class="capabilities-grid">
    <!-- 01 Software Development -->
    <article class="cap-card scroll-view-reveal border-b border-r">
      <div class="cap-header">
        <span class="cap-num font-mono">SYS::01</span>
        <span class="tech-tag tech-tag-signal font-mono">SOFTWARE &amp; CLOUD</span>
      </div>
      <div class="cap-body">
        <h3 class="cap-title">Custom Software Engineering &amp; Edge Platforms</h3>
        <p class="cap-desc">
          Resilient, typed, and clean software architecture. Web platforms, internal tooling, cloud-native microservices, and edge APIs designed to survive load spikes and simplify maintenance.
        </p>

        <!-- Architecture Flow Schematic -->
        <div class="flow-schematic font-mono" aria-label="System architecture pipeline">
          <div class="flow-node">UI LAYER<br><small>ASTRO / REACT</small></div>
          <div class="flow-arrow">&rarr;</div>
          <div class="flow-node active">EDGE WORKER<br><small>CLOUDFLARE</small></div>
          <div class="flow-arrow">&rarr;</div>
          <div class="flow-node">CORE API<br><small>TYPESCRIPT</small></div>
          <div class="flow-arrow">&rarr;</div>
          <div class="flow-node">DATASTORE<br><small>POSTGRES / REDIS</small></div>
        </div>

        <div class="cap-tech-row font-mono">
          <span class="tech-pill">TypeScript</span>
          <span class="tech-pill">Astro v5</span>
          <span class="tech-pill">Node / Go</span>
          <span class="tech-pill">PostgreSQL</span>
          <span class="tech-pill">Cloudflare Edge</span>
        </div>
      </div>
      <div class="cap-footer font-mono">
        <span class="cap-metric">COMPLEXITY: <strong>MINIMAL</strong></span>
        <a href="#contact" class="cap-link">DISCUSS ARCHITECTURE &rarr;</a>
      </div>
    </article>

    <!-- 02 Telecalling Services -->
    <article class="cap-card scroll-view-reveal border-b border-r">
      <div class="cap-header">
        <span class="cap-num font-mono">SYS::02</span>
        <span class="tech-tag font-mono">VOICE SQUADS</span>
      </div>
      <div class="cap-body">
        <h3 class="cap-title">B2B Telecalling &amp; High-Touch Voice Operations</h3>
        <p class="cap-desc">
          Trained human voice operations for inbound customer support and outbound B2B campaigns. Neutral English, Hindi, and regional proficiency with integrated CRM syncing and zero scripted robot monotony.
        </p>

        <div class="cap-spec-list font-mono">
          <div class="spec-bullet"><span class="bullet-dot"></span> Inbound technical support &amp; ticket triage</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> Outbound enterprise lead qualification</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> CRM telemetry: HubSpot, Salesforce, Zoho</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> 100% recorded &amp; supervisor-audited calls</div>
        </div>

        <div class="cap-tech-row font-mono">
          <span class="tech-pill">Neutral English</span>
          <span class="tech-pill">Hindi</span>
          <span class="tech-pill">Regional</span>
          <span class="tech-pill">24/7 Shifts</span>
        </div>
      </div>
      <div class="cap-footer font-mono">
        <span class="cap-metric">CALL QA SCORE: <strong>99.2%</strong></span>
        <a href="#contact" class="cap-link">REQUEST VOICE SQUAD &rarr;</a>
      </div>
    </article>

    <!-- 03 Data Entry & Management -->
    <article class="cap-card scroll-view-reveal border-b border-r">
      <div class="cap-header">
        <span class="cap-num font-mono">SYS::03</span>
        <span class="tech-tag font-mono">DATA PIPELINES</span>
      </div>
      <div class="cap-body">
        <h3 class="cap-title">Clean Data Mining &amp; Double-Blind QA</h3>
        <p class="cap-desc">
          Structured data pipelines with strict validation protocols. Multi-source scraping, double-blind record entry, fuzzy deduplication, and automated schema formatting to prevent database rot.
        </p>

        <div class="cap-spec-list font-mono">
          <div class="spec-bullet"><span class="bullet-dot"></span> Double-blind dual-operator keyed entry</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> Automated fuzzy deduplication algorithms</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> High-volume catalog &amp; inventory indexing</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> Structured ETL exports: JSON, CSV, SQL</div>
        </div>

        <div class="cap-tech-row font-mono">
          <span class="tech-pill">Double-Blind</span>
          <span class="tech-pill">ETL Pipelines</span>
          <span class="tech-pill">Regex QA</span>
          <span class="tech-pill">SQL Exports</span>
        </div>
      </div>
      <div class="cap-footer font-mono">
        <span class="cap-metric">VERIFIED PRECISION: <strong>99.8%</strong></span>
        <a href="#contact" class="cap-link">AUDIT DATA PIPELINE &rarr;</a>
      </div>
    </article>

    <!-- 04 Business Process & Industrial Solutions -->
    <article class="cap-card scroll-view-reveal border-b border-r">
      <div class="cap-header">
        <span class="cap-num font-mono">SYS::04</span>
        <span class="tech-tag font-mono">BACK-OFFICE</span>
      </div>
      <div class="cap-body">
        <h3 class="cap-title">Industrial Process &amp; Operational Back-Office</h3>
        <p class="cap-desc">
          Mission-critical human-in-the-loop workflows that keep manufacturing, logistics, and digital operations moving. Document indexing, invoice validation, exception triage, and compliance tracking.
        </p>

        <div class="cap-spec-list font-mono">
          <div class="spec-bullet"><span class="bullet-dot"></span> Purchase order &amp; invoice reconciliation</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> Industrial logistics dispatch coordination</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> Vendor documentation audit &amp; compliance</div>
          <div class="spec-bullet"><span class="bullet-dot"></span> Multi-shift real-time ticket escalation</div>
        </div>

        <div class="cap-tech-row font-mono">
          <span class="tech-pill">SOP Enforced</span>
          <span class="tech-pill">Invoice QA</span>
          <span class="tech-pill">Logistics</span>
          <span class="tech-pill">Zero Backlog</span>
        </div>
      </div>
      <div class="cap-footer font-mono">
        <span class="cap-metric">SLA ADHERENCE: <strong>100%</strong></span>
        <a href="#contact" class="cap-link">SCHEDULE OPERATIONS &rarr;</a>
      </div>
    </article>

    <!-- 05 US Medical Billing & Healthcare RCM (Wide Span Card) -->
    <article class="cap-card cap-card-wide scroll-view-reveal border-b">
      <div class="cap-header">
        <span class="cap-num font-mono">SYS::05</span>
        <span class="tech-tag tech-tag-acid font-mono">HEALTHCARE RCM // HIPAA COMPLIANT</span>
      </div>
      <div class="cap-body">
        <div class="cap-wide-grid">
          <div class="cap-wide-info">
            <h3 class="cap-title">US Healthcare Support &amp; Medical Billing (RCM)</h3>
            <p class="cap-desc">
              Comprehensive revenue cycle management for US clinics, healthcare providers, and billing companies. We enforce meticulous charge entry, patient demographic verification, ICD-10/CPT coding QA, and aggressive denial appeal workflows to accelerate cash flow and eliminate claim leakage.
            </p>
            <div class="cap-tech-row font-mono">
              <span class="tech-pill">HIPAA Audited</span>
              <span class="tech-pill">CPT / ICD-10</span>
              <span class="tech-pill">Clearinghouse QA</span>
              <span class="tech-pill">A/R Recovery</span>
              <span class="tech-pill">Denial Appeals</span>
            </div>
          </div>
          <div class="cap-wide-specs font-mono">
            <div class="wide-spec-box">
              <span class="spec-box-num">98.7%</span>
              <span class="spec-box-lbl">First-Pass Clean Claim Acceptance</span>
            </div>
            <div class="wide-spec-box">
              <span class="spec-box-num">&lt; 48h</span>
              <span class="spec-box-lbl">Charge Capture &amp; Scrubbing Turnaround</span>
            </div>
            <div class="wide-spec-box">
              <span class="spec-box-num">100%</span>
              <span class="spec-box-lbl">HIPAA &amp; HITECH Compliance Enforced</span>
            </div>
          </div>
        </div>
      </div>
      <div class="cap-footer font-mono">
        <span class="cap-metric">REVENUE LEAKAGE: <strong>0% TARGET</strong></span>
        <a href="#contact" class="cap-link">ENGAGE RCM SPECIALISTS &rarr;</a>
      </div>
    </article>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--bg-ink);
    color: var(--text-on-ink);
    position: relative;
    border-bottom: 1px solid var(--border-ink);
  }

  .services-intro {
    padding: clamp(40px, 6vw, 72px) var(--grid-pad);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    align-items: end;
    border-bottom: 1px solid var(--border-ink);
  }

  .services-headline {
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-top: 16px;
  }

  .acid-italic {
    color: var(--accent-acid);
  }

  .services-subtitle {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--text-muted-ink);
    max-width: 48ch;
  }

  /* Capabilities Grid: 2 columns top, 1 full-width bottom */
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .cap-card {
    background: var(--bg-surface-ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.2s ease;
  }

  .cap-card:hover {
    background: #181B1F;
  }

  .cap-card-wide {
    grid-column: 1 / -1;
  }

  .cap-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border-ink);
    background: rgba(255, 255, 255, 0.02);
  }

  .cap-num {
    font-size: 12px;
    color: var(--accent-signal);
    font-weight: 700;
  }

  .cap-body {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
  }

  .cap-title {
    font-size: clamp(1.3rem, 1.8vw, 1.7rem);
    letter-spacing: -0.03em;
    color: var(--text-on-ink);
  }

  .cap-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted-ink);
  }

  /* Flow schematic */
  .flow-schematic {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border-ink);
    overflow-x: auto;
    font-size: 10px;
  }

  .flow-node {
    padding: 6px 10px;
    border: 1px solid var(--border-ink);
    background: rgba(255, 255, 255, 0.03);
    text-align: center;
    white-space: nowrap;
    line-height: 1.2;
  }

  .flow-node.active {
    border-color: var(--accent-signal);
    color: var(--accent-signal);
    background: rgba(255, 59, 0, 0.08);
  }

  .flow-node small {
    font-size: 8px;
    opacity: 0.7;
    display: block;
  }

  .flow-arrow {
    color: var(--accent-signal);
    font-weight: 700;
  }

  /* Bullet list */
  .cap-spec-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
    color: #D2D0C8;
  }

  .spec-bullet {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bullet-dot {
    width: 4px;
    height: 4px;
    background-color: var(--accent-signal);
    border-radius: 50%;
  }

  .cap-tech-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
  }

  .tech-pill {
    font-size: 10px;
    padding: 4px 8px;
    border: 1px solid var(--border-ink);
    background: rgba(255, 255, 255, 0.03);
    color: #A09E96;
  }

  .cap-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-top: 1px solid var(--border-ink);
    background: rgba(0, 0, 0, 0.2);
    font-size: 11px;
  }

  .cap-metric {
    color: var(--text-muted-ink);
  }

  .cap-metric strong {
    color: var(--accent-acid);
  }

  .cap-link {
    color: var(--accent-signal);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: transform 0.15s ease;
  }

  .cap-link:hover {
    transform: translateX(3px);
  }

  /* Wide card layout */
  .cap-wide-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
  }

  .cap-wide-specs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
  }

  .wide-spec-box {
    padding: 14px 18px;
    border: 1px solid var(--border-ink);
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .spec-box-num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent-acid);
  }

  .spec-box-lbl {
    font-size: 11px;
    color: var(--text-muted-ink);
  }

  /* Responsive Matrix */
  @media (max-width: 960px) {
    .services-intro {
      grid-template-columns: 1fr;
    }
    .capabilities-grid {
      grid-template-columns: 1fr;
    }
    .cap-card {
      border-right: none;
    }
    .cap-wide-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Scroll-driven API hook */
  @supports (animation-timeline: view()) {
    .scroll-view-reveal {
      animation: view-reveal linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 30%;
    }
  }
</style>
