<script>
  // Filter tab switching
  const tabs = document.querySelectorAll(".filter-tab");
  const cards = document.querySelectorAll<HTMLElement>(".service-card");

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      tabs.forEach(t => {
        t.classList.remove("is-active");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.add("is-active");
      tab.setAttribute("aria-selected", "true");

      const filter = tab.getAttribute("data-filter") || "all";
      cards.forEach(card => {
        const match = filter === "all" || card.getAttribute("data-category") === filter;
        card.style.display = match ? "flex" : "none";
      });
    });
  });

  // Flow Accordion Toggle
  document.querySelectorAll(".flow-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") !== "true";
      btn.setAttribute("aria-expanded", String(open));
      btn.nextElementSibling?.classList.toggle("is-open", open);
    });
  });

  // Wire card action to pre-select service in contact form
  const actions = document.querySelectorAll("[data-service-select]");
  actions.forEach(btn => {
    btn.addEventListener("click", () => {
      const serviceName = btn.getAttribute("data-service-select");
      const serviceSelect = document.querySelector('select[name="service"]') as HTMLSelectElement | null;
      if (serviceSelect && serviceName) {
        for (let i = 0; i < serviceSelect.options.length; i++) {
          if (serviceSelect.options[i].text.includes(serviceName) || serviceName.includes(serviceSelect.options[i].text)) {
            serviceSelect.selectedIndex = i;
            break;
          }
        }
      }
    });
  });
</script>

