---
// Wisdom Technosoft — Services Component
// Deep Blueprint Engine Room • Asymmetric Bento Grid • Interactive System Modules
---

<section class="services-section s" id="services" data-theme-trigger="blueprint">
  <div class="w services-container">
    
    <!-- Section Architectural Header -->
    <div class="services-header">
      <div class="header-blueprint-strip">
        <span class="eyebrow">CAPABILITIES &bull; ARCHITECTURAL SUITE</span>
        <span class="blueprint-tag active"><span class="tag-dot"></span> ENGINE ROOM // RUNTIME V2</span>
      </div>

      <div class="header-split">
        <h2 class="sec-title">
          Precision engineering. <br />
          <span class="text-cyan">Operational scale.</span>
        </h2>
        <p class="sec-subtitle">
          From cloud-native web systems to high-touch voice calling, clean data ETL pipelines, and US medical billing &mdash; we power the back-office and technology engines behind growing global enterprises.
        </p>
      </div>

      <!-- Swiss Grid Capability Filter Tabs -->
      <div class="services-filter-bar" role="tablist" aria-label="Filter service capabilities">
        <button class="filter-tab is-active" data-filter="all" role="tab" aria-selected="true">
          <span class="f-num">ALL</span> All Capabilities <span class="tab-badge">05</span>
        </button>
        <button class="filter-tab" data-filter="software" role="tab" aria-selected="false">
          <span class="f-num">01</span> Software Engineering <span class="tab-badge">01</span>
        </button>
        <button class="filter-tab" data-filter="voice" role="tab" aria-selected="false">
          <span class="f-num">02</span> Voice &amp; Telecalling <span class="tab-badge">01</span>
        </button>
        <button class="filter-tab" data-filter="data" role="tab" aria-selected="false">
          <span class="f-num">03</span> Data Operations <span class="tab-badge">01</span>
        </button>
        <button class="filter-tab" data-filter="bpo" role="tab" aria-selected="false">
          <span class="f-num">04</span> Business Process <span class="tab-badge">01</span>
        </button>
        <button class="filter-tab" data-filter="healthcare" role="tab" aria-selected="false">
          <span class="f-num">05</span> Healthcare &amp; RCM <span class="tab-badge">01</span>
        </button>
      </div>
    </div>

    <!-- Asymmetric Bento Blueprint Grid -->
    <div class="bento-grid" id="services-grid">

      <!-- ===================================================================
           MODULE 01: Software Development (Hero Large Bento Card)
           =================================================================== -->
      <article class="bento-card bento-hero grid-frame" data-category="software">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="card-meta-bar">
          <div class="meta-left">
            <span class="module-code">MOD // 01</span>
            <span class="blueprint-tag">SYSTEMS &amp; CLOUD ARCHITECTURE</span>
          </div>
          <span class="status-indicator live">RUNNING</span>
        </div>

        <div class="bento-hero-split">
          <div class="bento-copy">
            <h3 class="bento-title">Custom Software Engineering</h3>
            <p class="bento-desc">
              High-velocity, resilient software built around your exact business requirements &mdash; cloud-native web platforms, mobile applications, internal operational tools, and automated microservices with zero bloat.
            </p>

            <div class="bento-spec-list">
              <div class="spec-row">
                <span class="spec-bullet">&rarr;</span>
                <span>Custom Web &amp; SaaS Platforms (Astro, React, Node, TypeScript)</span>
              </div>
              <div class="spec-row">
                <span class="spec-bullet">&rarr;</span>
                <span>Native &amp; Cross-Platform Mobile Apps (iOS &amp; Android)</span>
              </div>
              <div class="spec-row">
                <span class="spec-bullet">&rarr;</span>
                <span>High-Throughput APIs, Edge Caching &amp; PostgreSQL Optimization</span>
              </div>
              <div class="spec-row">
                <span class="spec-bullet">&rarr;</span>
                <span>Automated Workflow Microservices &amp; Zero-Downtime CI/CD</span>
              </div>
            </div>

            <div class="bento-card-actions">
              <a href="#contact" class="btn btn-primary btn-sm" data-service-select="Software Development">
                <span>Deploy with us</span>
                <span>&rarr;</span>
              </a>
              <span class="action-note">Direct engineer consultations</span>
            </div>
          </div>

          <!-- Interactive Code-to-Reality Diff Toggle -->
          <div class="interactive-sandbox">
            <div class="sandbox-header">
              <span class="sandbox-title">&lang;/&rang; RUNTIME DIFF INSPECTOR</span>
              <div class="sandbox-toggle-group">
                <button class="sandbox-toggle-btn is-active" id="btn-marketing" type="button">What Marketing Says</button>
                <button class="sandbox-toggle-btn" id="btn-reality" type="button">What Engineers Built</button>
              </div>
            </div>

            <!-- View A: Marketing Claims -->
            <div class="sandbox-view view-marketing is-visible" id="view-marketing">
              <div class="diff-container">
                <div class="diff-header">
                  <span>SPEC // HYPOTHETICAL_PITCH.TS</span>
                  <span class="text-orange">UNVERIFIED</span>
                </div>
                <div class="diff-line del"><span class="line-no">01</span><span>- // "AI-powered blockchain microservice"</span></div>
                <div class="diff-line del"><span class="line-no">02</span><span>- const app = new MagicBlackBox({</span></div>
                <div class="diff-line del"><span class="line-no">03</span><span>-   hypeCycles: Infinity,</span></div>
                <div class="diff-line del"><span class="line-no">04</span><span>-   vendorLockin: true,</span></div>
                <div class="diff-line del"><span class="line-no">05</span><span>-   memoryLeaks: "included"</span></div>
                <div class="diff-line del"><span class="line-no">06</span><span>- });</span></div>
              </div>
              <div class="sandbox-caption">
                <span class="warn-dot"></span> Generic AI boilerplates crash under Monday morning traffic.
              </div>
            </div>

            <!-- View B: Real Engineering Reality -->
            <div class="sandbox-view view-reality" id="view-reality">
              <div class="diff-container">
                <div class="diff-header">
                  <span>SRC // EDGE_ROUTER.TS</span>
                  <span class="text-cyan">VERIFIED 100% PASS</span>
                </div>
                <div class="diff-line add"><span class="line-no">01</span><span>+ export async function handle(req: Request) &#123;</span></div>
                <div class="diff-line add"><span class="line-no">02</span><span>+   const hit = await edgeKV.get(req.url);</span></div>
                <div class="diff-line add"><span class="line-no">03</span><span>+   if (hit) return new Response(hit); // p99: 4ms</span></div>
                <div class="diff-line add"><span class="line-no">04</span><span>+   return queryPgPool(req); // Connection pooling</span></div>
                <div class="diff-line add"><span class="line-no">05</span><span>+ &#125;</span></div>
              </div>
              <div class="sandbox-caption">
                <span class="cyan-dot"></span> Real code: Type-safe, cached at edge, resilient to traffic surges.
              </div>
            </div>

            <!-- Flow Diagram Steps -->
            <div class="architecture-flow-stepper">
              <div class="flow-pill active"><span class="fp-n">01</span> Edge DNS</div>
              <div class="flow-arrow">&rarr;</div>
              <div class="flow-pill active"><span class="fp-n">02</span> Cloudflare Edge</div>
              <div class="flow-arrow">&rarr;</div>
              <div class="flow-pill"><span class="fp-n">03</span> SSR Cluster</div>
              <div class="flow-arrow">&rarr;</div>
              <div class="flow-pill"><span class="fp-n">04</span> Postgres Pool</div>
            </div>
          </div>
        </div>
      </article>

      <!-- ===================================================================
           MODULE 02: Telecalling Services (Voice Operations)
           =================================================================== -->
      <article class="bento-card grid-frame" data-category="voice">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="card-meta-bar">
          <div class="meta-left">
            <span class="module-code">MOD // 02</span>
            <span class="blueprint-tag">VOICE &amp; TELECALLING</span>
          </div>
          <span class="status-indicator active">LIVE DIALER</span>
        </div>

        <h3 class="bento-title">Voice &amp; Telecalling Squads</h3>
        <p class="bento-desc">
          Courteous, outcome-driven customer and B2B conversations. Dedicated caller squads in English, Hindi, and regional languages with live whisper QA and instant CRM sync.
        </p>

        <!-- Interactive Voice QA Telemetry Box -->
        <div class="interactive-voice-box">
          <div class="voice-box-top">
            <span class="voice-chan">SQUAD SELECTION</span>
            <div class="voice-lang-toggles" id="voice-lang-toggles">
              <button class="v-lang-btn is-active" data-lang="en">EN (Neutral)</button>
              <button class="v-lang-btn" data-lang="hi">HI (Hindi)</button>
              <button class="v-lang-btn" data-lang="mr">MR (Regional)</button>
            </div>
          </div>

          <div class="voice-metrics-display">
            <div class="vm-row">
              <span class="vm-lbl">QA Scorecard Target</span>
              <span class="vm-val" id="voice-qa-val">99.4% Verified</span>
            </div>
            <div class="vm-row">
              <span class="vm-lbl">CRM Sync Latency</span>
              <span class="vm-val" id="voice-sync-val">&lt; 1.2s Real-time</span>
            </div>
            <div class="vm-row">
              <span class="vm-lbl">Dialer Mode</span>
              <span class="vm-val" id="voice-mode-val">Inbound Helpdesk + B2B Outbound</span>
            </div>
          </div>
        </div>

        <div class="bento-spec-list">
          <div class="spec-row"><span class="spec-bullet">&check;</span> B2B Outbound Lead Qualification Campaigns</div>
          <div class="spec-row"><span class="spec-bullet">&check;</span> Inbound Customer Support &amp; Helpdesk</div>
          <div class="spec-row"><span class="spec-bullet">&check;</span> Multilingual Coverage (English, Hindi, Regional)</div>
        </div>

        <div class="bento-card-actions">
          <a href="#contact" class="btn btn-secondary btn-sm" data-service-select="Telecalling Services">
            <span>Book calling squad</span>
            <span>&rarr;</span>
          </a>
        </div>
      </article>

      <!-- ===================================================================
           MODULE 03: Data Entry & Management
           =================================================================== -->
      <article class="bento-card grid-frame" data-category="data">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="card-meta-bar">
          <div class="meta-left">
            <span class="module-code">MOD // 03</span>
            <span class="blueprint-tag">CLEAN DATA &amp; ETL PIPELINES</span>
          </div>
          <span class="status-indicator active">DOUBLE-BLIND QA</span>
        </div>

        <h3 class="bento-title">Data Mining &amp; Management</h3>
        <p class="bento-desc">
          Zero-defect data structuring, web scraping, and records management. Every batch passes automated checksums and dual-operator verification before delivery.
        </p>

        <!-- Interactive Data Cleansing Inspector -->
        <div class="interactive-data-box">
          <div class="data-box-header">
            <span class="data-title">DOUBLE-BLIND VERIFICATION PIPELINE</span>
            <span class="data-pct">99.8% PRECISION</span>
          </div>
          <div class="data-pipeline-visual">
            <div class="dp-stage">
              <span class="dp-tag">RAW INGEST</span>
              <span class="dp-desc">Messy scrapers, PDFs, legacy logs</span>
            </div>
            <div class="dp-divider">&darr;</div>
            <div class="dp-stage dp-highlight">
              <span class="dp-tag">DOUBLE-BLIND QA</span>
              <span class="dp-desc">Automated schema validation + 2 independent passes</span>
            </div>
            <div class="dp-divider">&darr;</div>
            <div class="dp-stage">
              <span class="dp-tag">CLEAN DATASTORE</span>
              <span class="dp-desc">Deduplicated, audit-ready JSON/PostgreSQL</span>
            </div>
          </div>
        </div>

        <div class="bento-spec-list">
          <div class="spec-row"><span class="spec-bullet">&check;</span> High-Volume Data Entry &amp; Normalization</div>
          <div class="spec-row"><span class="spec-bullet">&check;</span> Document Digitization &amp; Information Extraction</div>
          <div class="spec-row"><span class="spec-bullet">&check;</span> Catalog, Inventory &amp; Records Cleansing</div>
        </div>

        <div class="bento-card-actions">
          <a href="#contact" class="btn btn-secondary btn-sm" data-service-select="Data Entry & Management">
            <span>Clean your data</span>
            <span>&rarr;</span>
          </a>
        </div>
      </article>

      <!-- ===================================================================
           MODULE 04: Business Process & Industrial Solutions
           =================================================================== -->
      <article class="bento-card grid-frame" data-category="bpo">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="card-meta-bar">
          <div class="meta-left">
            <span class="module-code">MOD // 04</span>
            <span class="blueprint-tag">OPERATIONAL WORKFLOWS</span>
          </div>
          <span class="status-indicator">SAP &bull; INDUSTRIAL</span>
        </div>

        <h3 class="bento-title">Business Process &amp; Industrial Operations</h3>
        <p class="bento-desc">
          Operational execution for heavy industry, logistics, and digital commerce &mdash; supply-chain execution on SAP, e-commerce catalog management, and industrial instrumentation support (STP, ETP, chemical machinery).
        </p>

        <div class="bento-spec-list">
          <div class="spec-row"><span class="spec-bullet">&check;</span> SAP Order-to-Cash &amp; Supply Chain Processing</div>
          <div class="spec-row"><span class="spec-bullet">&check;</span> E-Commerce Store Builds &amp; SKU Catalog Ops</div>
          <div class="spec-row"><span class="spec-bullet">&check;</span> Industrial Water Systems (STP/ETP instrumentation)</div>
        </div>

        <div class="bento-card-actions">
          <a href="#contact" class="btn btn-secondary btn-sm" data-service-select="Business Process & Industrial Solutions">
            <span>Inquire for BPO</span>
            <span>&rarr;</span>
          </a>
        </div>
      </article>

      <!-- ===================================================================
           MODULE 05: Healthcare Support & US Medical Billing (Wide Bento Spotlight)
           =================================================================== -->
      <article class="bento-card bento-wide grid-frame" data-category="healthcare">
        <div class="crosshair crosshair-tl"></div>
        <div class="crosshair crosshair-tr"></div>
        <div class="crosshair crosshair-bl"></div>
        <div class="crosshair crosshair-br"></div>

        <div class="card-meta-bar">
          <div class="meta-left">
            <span class="module-code">MOD // 05</span>
            <span class="blueprint-tag">HEALTHCARE RCM &bull; US MEDICAL BILLING</span>
          </div>
          <span class="status-indicator live">HIPAA COMPLIANT</span>
        </div>

        <div class="healthcare-split">
          <div class="hc-copy">
            <h3 class="bento-title">US Medical Billing &amp; Revenue Cycle Support</h3>
            <p class="bento-desc">
              Accurate, audit-ready back-office support for US healthcare practices and billing agencies. Clean CMS-1500 &amp; UB-04 claims scrubbing, root-cause denial management, and ERA 835 payment posting with a documented 98.7% clean claim rate.
            </p>

            <div class="bento-spec-list">
              <div class="spec-row"><span class="spec-bullet">&check;</span> CPT, ICD-10 &amp; HCPCS Coding Verification</div>
              <div class="spec-row"><span class="spec-bullet">&check;</span> Automated Pre-Submission Claim Scrubbing</div>
              <div class="spec-row"><span class="spec-bullet">&check;</span> Denial Management, Appeal Letters &amp; AR Reduction</div>
              <div class="spec-row"><span class="spec-bullet">&check;</span> HIPAA Compliant Infrastructure &amp; Data Security</div>
            </div>

            <div class="bento-card-actions">
              <a href="#contact" class="btn btn-primary btn-sm" data-service-select="Healthcare Support / US Medical Billing">
                <span>Request RCM audit</span>
                <span>&rarr;</span>
              </a>
              <span class="action-note">98.7% First-pass acceptance rate</span>
            </div>
          </div>

          <!-- Interactive Claim Scrubber Telemetry Module -->
          <div class="hc-telemetry-console">
            <div class="console-head">
              <span class="c-title">EDI 837 CLAIM VERIFICATION ENGINE</span>
              <span class="c-status">SCRUBBER READY</span>
            </div>

            <div class="claim-pipeline-steps">
              <div class="c-step done">
                <span class="cs-num">01</span>
                <div class="cs-info">
                  <strong>Patient Intake &amp; Superbill</strong>
                  <span>Demographics &amp; eligibility verified</span>
                </div>
                <span class="cs-check">&check;</span>
              </div>
              <div class="c-step done">
                <span class="cs-num">02</span>
                <div class="cs-info">
                  <strong>CPT / ICD-10 Coding Audit</strong>
                  <span>Zero unbundling &bull; NCCI edits cleared</span>
                </div>
                <span class="cs-check">&check;</span>
              </div>
              <div class="c-step active">
                <span class="cs-num">03</span>
                <div class="cs-info">
                  <strong>Clearinghouse Batch Send (EDI 837)</strong>
                  <span>Instant 999 acknowledgement received</span>
                </div>
                <span class="cs-tag">LIVE PASS</span>
              </div>
              <div class="c-step">
                <span class="cs-num">04</span>
                <div class="cs-info">
                  <strong>ERA 835 Posting &amp; AR Balance</strong>
                  <span>Auto-reconciliation to practice management</span>
                </div>
                <span class="cs-pending">--</span>
              </div>
            </div>

            <div class="console-foot">
              <span class="cf-metric">AR DAYS REDUCTION: <strong>-22%</strong></span>
              <span class="cf-metric">CLEAN CLAIM RATE: <strong>98.7%</strong></span>
            </div>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<script>
  // Interactive Code-to-Reality Diff Toggle
  const btnMarketing = document.getElementById("btn-marketing");
  const btnReality = document.getElementById("btn-reality");
  const viewMarketing = document.getElementById("view-marketing");
  const viewReality = document.getElementById("view-reality");

  btnMarketing?.addEventListener("click", () => {
    btnMarketing.classList.add("is-active");
    btnReality?.classList.remove("is-active");
    viewMarketing?.classList.add("is-visible");
    viewReality?.classList.remove("is-visible");
  });

  btnReality?.addEventListener("click", () => {
    btnReality.classList.add("is-active");
    btnMarketing?.classList.remove("is-active");
    viewReality?.classList.add("is-visible");
    viewMarketing?.classList.remove("is-visible");
  });

  // Interactive Voice Squad Lang Switcher
  const langBtns = document.querySelectorAll<HTMLButtonElement>(".v-lang-btn");
  const voiceQaVal = document.getElementById("voice-qa-val");
  const voiceSyncVal = document.getElementById("voice-sync-val");
  const voiceModeVal = document.getElementById("voice-mode-val");

  const langData: Record<string, { qa: string; sync: string; mode: string }> = {
    en: { qa: "99.4% Verified", sync: "< 1.2s Real-time", mode: "Inbound Helpdesk + B2B Outbound" },
    hi: { qa: "99.1% Verified", sync: "< 1.4s Real-time", mode: "Pan-India Hindi Inbound/Outbound" },
    mr: { qa: "99.5% Verified", sync: "< 1.1s Real-time", mode: "Maharashtra Regional Hub" }
  };

  langBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      langBtns.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      const lang = btn.getAttribute("data-lang") || "en";
      const data = langData[lang];
      if (data && voiceQaVal && voiceSyncVal && voiceModeVal) {
        voiceQaVal.textContent = data.qa;
        voiceSyncVal.textContent = data.sync;
        voiceModeVal.textContent = data.mode;
      }
    });
  });

  // Filter Tabs logic
  const filterTabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
  const bentoCards = document.querySelectorAll<HTMLElement>(".bento-card");

  filterTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      filterTabs.forEach((t) => {
        t.classList.remove("is-active");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.add("is-active");
      tab.setAttribute("aria-selected", "true");

      const filter = tab.getAttribute("data-filter") || "all";
      bentoCards.forEach((card) => {
        const cat = card.getAttribute("data-category");
        if (filter === "all" || filter === cat) {
          card.style.display = "grid";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>

<style>
  .services-section {
    position: relative;
    padding-block: clamp(80px, 12vh, 140px);
    background-color: var(--bg);
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }

  .services-header {
    margin-bottom: 48px;
  }

  .header-blueprint-strip {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .header-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    align-items: flex-end;
    margin-bottom: 36px;
  }

  .text-cyan {
    color: var(--accent);
  }

  /* Filter Bar */
  .services-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-muted);
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .f-num {
    font-size: 9px;
    color: var(--accent);
    opacity: 0.8;
  }

  .tab-badge {
    font-size: 9px;
    padding: 1px 5px;
    background: var(--surface-card);
    border: 1px solid var(--border);
  }

  .filter-tab:hover,
  .filter-tab.is-active {
    color: var(--ink);
    background: var(--surface-card);
    border-color: var(--border-strong);
  }

  .filter-tab.is-active .f-num {
    color: var(--accent);
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .bento-card {
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .bento-card:hover {
    border-color: var(--accent);
  }

  .bento-hero,
  .bento-wide {
    grid-column: span 2;
  }

  .card-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    font-family: var(--mono);
    font-size: 10px;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .module-code {
    color: var(--accent);
    font-weight: 700;
  }

  .status-indicator {
    padding: 2px 6px;
    border: 1px solid var(--border);
    color: var(--ink-muted);
    background: var(--surface);
  }

  .status-indicator.live {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-tint);
  }

  .bento-title {
    font-family: var(--disp);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .bento-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: 24px;
