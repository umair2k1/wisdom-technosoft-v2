---
// Wisdom Technosoft — Nav Component
// Swiss Grid Architectural Nav • Hero-to-Nav Logo Dock Target • Real Telemetry HUD
---

<header class="nav" id="nav">
  <div class="nav-container">
    <!-- Brand & Hero Logo Dock Target -->
    <a class="brand" href="#top" aria-label="Wisdom Technosoft home">
      <div class="brand-logo-dock" id="nav-logo-dock">
        <img src="/assets/logo-mark.png" alt="Wisdom Technosoft" class="nav-logo nav-logo-dark" width="34" height="28" />
        <img src="/assets/logo-mark-light.png" alt="Wisdom Technosoft" class="nav-logo nav-logo-light" width="34" height="28" />
      </div>
      <div class="brand-text">
        <span class="brand-name">Wisdom Technosoft</span>
        <span class="brand-sub">Engineering &bull; BPO Operations</span>
      </div>
    </a>

    <!-- Center Live Telemetry HUD Pill (Witty & Honest Engineering) -->
    <div class="nav-telemetry" aria-label="Real client-side DOM performance">
      <span class="telemetry-dot"></span>
      <div class="telemetry-metrics">
        <span class="t-badge">0% FAKE TELEMETRY</span>
        <span class="t-sep">//</span>
        <span class="t-val">PAINT: <strong class="real-paint-stat">--ms</strong></span>
        <span class="t-sep">//</span>
        <span class="t-val"><strong class="real-fps-stat">60 FPS</strong></span>
        <span class="t-sep">//</span>
        <span class="t-clock live-clock">--:--:-- IST</span>
      </div>
    </div>

    <!-- Primary Navigation Links -->
    <nav class="nav-links" aria-label="Primary navigation">
      <a href="#services" class="nav-link"><span>01</span>Services</a>
      <a href="#approach" class="nav-link"><span>02</span>Approach</a>
      <a href="#vision" class="nav-link"><span>03</span>Vision</a>
      <a href="#team" class="nav-link"><span>04</span>Team</a>
      <a href="#contact" class="nav-link"><span>05</span>Contact</a>
    </nav>

    <!-- Nav Actions -->
    <div class="nav-actions">
      <a class="nav-tel" href="tel:+917447331127" title="Call direct">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>+91 74473 31127</span>
      </a>

      <a class="btn btn-primary btn-sm nav-cta" href="#contact">
        <span>Start a project</span>
        <span class="cta-arrow">&rarr;</span>
      </a>

      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobile-menu" aria-hidden="true">
    <div class="drawer-inner">
      <div class="drawer-telemetry">
        <span class="telemetry-dot"></span>
        <span>Nagpur Hub Active &bull; <strong class="live-clock">--:--:-- IST</strong></span>
      </div>
      <nav class="drawer-links" aria-label="Mobile navigation">
        <a href="#services" class="drawer-link"><span class="d-num">01</span> Services</a>
        <a href="#approach" class="drawer-link"><span class="d-num">02</span> Approach</a>
        <a href="#vision" class="drawer-link"><span class="d-num">03</span> Vision &amp; Values</a>
        <a href="#team" class="drawer-link"><span class="d-num">04</span> Leadership &amp; Team</a>
        <a href="#contact" class="drawer-link"><span class="d-num">05</span> Contact Us</a>
      </nav>
      <div class="drawer-footer">
        <div class="drawer-contact-item">
          <span class="drawer-label">Direct line</span>
          <a href="tel:+917447331127" class="drawer-val">+91 74473 31127</a>
        </div>
        <div class="drawer-contact-item">
          <span class="drawer-label">Email inquiry</span>
          <a href="mailto:wisdomtechnosoft04@gmail.com" class="drawer-val">wisdomtechnosoft04@gmail.com</a>
        </div>
        <a class="btn btn-primary drawer-cta" href="#contact">Start a project &rarr;</a>
      </div>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById("nav");
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("mobile-menu");
  const drawerLinks = document.querySelectorAll(".drawer-link, .drawer-cta");

  function setOpen(open: boolean) {
    if (!toggle || !drawer || !nav) return;
    toggle.setAttribute("aria-expanded", String(open));
    drawer.setAttribute("aria-hidden", String(!open));
    nav.classList.toggle("is-open", open);
    document.body.classList.toggle("menu-locked", open);
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setOpen(!isOpen);
  });

  drawerLinks.forEach(link => {
    link.addEventListener("click", () => {
      setOpen(false);
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 210;
    height: var(--nav-h, 70px);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.3s ease;
  }

  .nav.scrolled {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border-bottom-color: var(--border-strong);
  }

  .nav-container {
    max-width: 1440px;
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--g);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Brand and Logo Slot */
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-dock {
    position: relative;
    width: 34px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-logo {
    position: absolute;
    width: 34px;
    height: auto;
    transition: opacity 0.3s ease;
  }

  /* Theme-dependent logo mark switching */
  .nav-logo-light {
    opacity: 0;
  }
  .nav-logo-dark {
    opacity: 1;
  }

  [data-theme="blueprint"] .nav-logo-light,
  .theme-blueprint .nav-logo-light {
    opacity: 1;
  }
  [data-theme="blueprint"] .nav-logo-dark,
  .theme-blueprint .nav-logo-dark {
    opacity: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .brand-name {
    font-family: var(--disp);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
  }

  .brand-sub {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Center Telemetry HUD */
  .nav-telemetry {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    user-select: none;
  }

  .telemetry-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    display: inline-block;
  }

  .telemetry-metrics {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-muted);
  }

  .t-badge {
    color: var(--accent);
    font-weight: 700;
    font-size: 10px;
  }

  .t-sep {
    color: var(--border-strong);
    opacity: 0.7;
  }

  .t-val strong,
  .t-clock {
    color: var(--ink);
    font-weight: 600;
  }

  /* Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link span {
    font-size: 9px;
    color: var(--accent);
    opacity: 0.8;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--ink);
    background: var(--surface);
  }

  /* Nav Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .nav-tel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink-muted);
    border: 1px solid var(--border);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .nav-tel:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .nav-cta {
    padding: 8px 16px;
    font-size: 11.5px;
  }

  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .nav-cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* Mobile Toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .toggle-bar {
    width: 18px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav.is-open .toggle-bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav.is-open .toggle-bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: var(--nav-h, 70px);
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 24px var(--g);
    z-index: 205;
    overflow-y: auto;
  }

  .nav.is-open .mobile-drawer {
    display: block;
  }

  .drawer-telemetry {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-muted);
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    margin-bottom: 24px;
  }

  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .drawer-link {
    font-family: var(--disp);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .d-num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
  }

  .drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 16px;
  }

  .drawer-contact-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--mono);
  }

  .drawer-label {
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .drawer-val {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  .drawer-cta {
    width: 100%;
    margin-top: 8px;
  }

  @media (max-width: 1120px) {
    .nav-telemetry {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-tel,
    .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>
