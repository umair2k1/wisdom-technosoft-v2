<script>
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("mobile-hud");
  const header = document.getElementById("hud-nav");
  const drawerAnchors = document.querySelectorAll(".m-link, .m-cta");

  function setDrawer(open: boolean) {
    if (!toggle || !drawer || !header) return;
    toggle.setAttribute("aria-expanded", String(open));
    drawer.setAttribute("aria-hidden", String(!open));
    header.classList.toggle("is-open", open);
    document.body.classList.toggle("hud-locked", open);
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setDrawer(!isOpen);
  });

  drawerAnchors.forEach((a) => {
    a.addEventListener("click", () => setDrawer(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setDrawer(false);
    }
  });
</script>

<style>
  .hud-nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background-color: rgba(244, 242, 236, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-paper);
    transition: background-color 0.2s ease;
  }

  .hud-shell {
    max-width: var(--max-width);
    margin-inline: auto;
    height: var(--nav-height);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: stretch;
    border-inline: 1px solid var(--border-paper);
  }

  .nav-cell {
    display: flex;
    align-items: center;
    padding-inline: clamp(12px, 1.6vw, 24px);
    border-right: 1px solid var(--border-paper);
  }

  .nav-cell:last-child {
    border-right: none;
  }

  /* Brand Cell */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-img {
    display: block;
    object-fit: contain;
  }

  .brand-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* Links Cell */
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.8vw, 28px);
    justify-content: center;
  }

  .nav-anchor {
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.15s ease;
  }

  .nav-idx {
    color: var(--accent-signal);
    font-weight: 700;
  }

  .nav-anchor:hover {
    color: var(--text-primary);
  }

  /* Status Cell */
  .nav-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.05em;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.02);
  }

  .status-text {
    font-weight: 600;
    color: var(--text-primary);
  }

  .status-sep {
    opacity: 0.3;
  }

  .status-tag {
    color: var(--accent-signal);
    font-weight: 700;
  }

  /* Actions Cell */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-tel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding: 6px 10px;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .nav-tel:hover {
    color: var(--text-primary);
    border-color: var(--border-paper);
    background: var(--bg-surface);
  }

  .nav-cta {
    padding: 10px 16px;
    font-size: 11px;
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border-paper);
    width: 36px;
    height: 36px;
    padding: 8px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
  }

  .bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* ==========================================================================
     SCROLL-DRIVEN PROGRESS BAR
     ========================================================================== */
  .scroll-progress-wire {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 3px;
    background-color: var(--accent-signal);
    transform-origin: left;
    transform: scaleX(0);
    z-index: 1001;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    .scroll-progress-wire {
      animation: scale-progress linear both;
      animation-timeline: scroll(root block);
    }
  }

  /* Mobile HUD Drawer */
  .mobile-hud {
    display: none;
  }

  @media (max-width: 1120px) {
    .nav-status {
      display: none;
    }
    .hud-shell {
      grid-template-columns: auto 1fr auto;
    }
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-tel,
    .nav-cta {
      display: none;
    }

    .hud-shell {
      grid-template-columns: 1fr auto;
    }

    .nav-toggle {
      display: flex;
    }

    .mobile-hud {
      display: block;
      position: fixed;
      top: var(--nav-height);
      left: 0;
      width: 100vw;
      height: calc(100vh - var(--nav-height));
      background: var(--bg-paper);
      border-top: 1px solid var(--border-paper);
      overflow-y: auto;
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      z-index: 999;
      transition: transform 0.25s var(--ease-industrial), opacity 0.2s ease;
    }
    .hud-nav.is-open .mobile-hud {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }


    .hud-nav.is-open .bar-top {
      transform: translateY(4px) rotate(45deg);
    }

    .hud-nav.is-open .bar-bot {
      transform: translateY(-4px) rotate(-45deg);
    }

    .mobile-hud-inner {
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      max-width: 600px;
      margin-inline: auto;
    }

    .mobile-hud-header {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      border-bottom: 1px solid var(--border-paper);
      padding-bottom: 12px;
    }

    .mobile-links {
      display: flex;
      flex-direction: column;
      border-left: 1px solid var(--border-paper);
    }

    .m-link {
      display: flex;
      flex-direction: column;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-paper);
      text-decoration: none;
      color: var(--text-primary);
      font-size: 14px;
      font-weight: 700;
      gap: 4px;
    }

    .m-idx {
      color: var(--accent-signal);
      font-size: 11px;
    }

    .m-sub {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 400;
    }

    .mobile-hud-footer {
      display: flex;
      flex-direction: column;
      gap: 12px;
      border-top: 1px solid var(--border-paper);
      padding-top: 16px;
    }

    .mobile-contact-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
    }

    .mobile-contact-row a {
      color: var(--text-primary);
      text-decoration: none;
      font-weight: 600;
    }

    .m-cta {
      width: 100%;
      margin-top: 8px;
    }
  }
</style>
