---
---

<section class="approach-section junction-marker" id="approach" data-theme="paper">
  <!-- Section Meta Bar -->
  <div class="section-meta-bar">
    <div class="meta-left">
      <span class="meta-index">[02 // DISCIPLINES]</span>
      <span class="meta-tag">OPERATING PROTOCOL &bull; THE ENGINEERING CONTRACT</span>
    </div>
    <div class="meta-right">
      <span class="meta-annotation font-mono">DETERMINISTIC RESULTS &bull; 0% RETREAT</span>
    </div>
  </div>

  <div class="approach-intro">
    <div class="intro-left">
      <span class="tech-tag tech-tag-signal font-mono">STANDARDS // AUDITABLE</span>
      <h2 class="approach-headline">
        An engineering <span class="font-serif-italic signal-italic">contract</span>, not a vague agency retainer.
      </h2>
    </div>
    <p class="approach-subtitle">
      Four governing operational principles define every engagement. Whether delivering custom software architecture, staffing a 24/7 telecalling squad, or auditing a healthcare billing pipeline, we stand behind concrete deliverables.
    </p>
  </div>

  <!-- 4-Grid Architectural Approach Layout -->
  <div class="disciplines-grid">
    <!-- 01 Zero Regression -->
    <div class="discipline-card scroll-view-reveal border-b border-r">
      <div class="discipline-wire" aria-hidden="true"></div>
      <div class="discipline-head font-mono">
        <span class="d-num">[01]</span>
        <span class="d-label">QUALITY DISCIPLINE</span>
      </div>
      <div class="discipline-body">
        <h3 class="discipline-title">Zero-Regression Engineering</h3>
        <p class="discipline-desc">
          We sweat the edge cases because production crashes on edge cases. Software undergoes strict TypeScript compilation, multi-tier automated test suites, and data tasks pass rigorous double-blind verification before deployment.
        </p>
        <div class="discipline-specs font-mono">
          <div class="d-spec-item"><span class="d-pip"></span> Strict code reviews &amp; lint gates</div>
          <div class="d-spec-item"><span class="d-pip"></span> Multi-tier double-blind data entry</div>
          <div class="d-spec-item"><span class="d-pip"></span> Zero regression deployment cadence</div>
        </div>
      </div>
      <div class="discipline-foot font-mono">
        <span class="d-target">TARGET SLA: <strong>99.8% PRECISION</strong></span>
      </div>
    </div>

    <!-- 02 Deterministic Milestones -->
    <div class="discipline-card scroll-view-reveal border-b border-r">
      <div class="discipline-wire" aria-hidden="true"></div>
      <div class="discipline-head font-mono">
        <span class="d-num">[02]</span>
        <span class="d-label">EXECUTION CADENCE</span>
      </div>
      <div class="discipline-body">
        <h3 class="discipline-title">Deterministic Milestones</h3>
        <p class="discipline-desc">
          No agile hand-waving or endless sprint rollover excuses. Scopes of work with concrete deadlines, clear checkpoint deliverables, and weekly telemetry so you never have to guess when code ships.
        </p>
        <div class="discipline-specs font-mono">
          <div class="d-spec-item"><span class="d-pip"></span> Contractual milestone planning</div>
          <div class="d-spec-item"><span class="d-pip"></span> Weekly live status &amp; ticket dashboards</div>
          <div class="d-spec-item"><span class="d-pip"></span> Fixed-scope and sprint accountability</div>
        </div>
      </div>
      <div class="discipline-foot font-mono">
        <span class="d-target">TIMELINE ADHERENCE: <strong>100%</strong></span>
      </div>
    </div>

    <!-- 03 Right-Sized Tooling -->
    <div class="discipline-card scroll-view-reveal border-b border-r">
      <div class="discipline-wire" aria-hidden="true"></div>
      <div class="discipline-head font-mono">
        <span class="d-num">[03]</span>
        <span class="d-label">TOOLING &amp; ARCHITECTURE</span>
      </div>
      <div class="discipline-body">
        <h3 class="discipline-title">Right-Sized, Lean Stacks</h3>
        <p class="discipline-desc">
          We don't spin up a 12-node Kubernetes cluster to host a landing page. We pick pragmatic, boring, and ultra-reliable technology stacks that reduce cloud spend, minimize attack surface, and maximize uptime.
        </p>
        <div class="discipline-specs font-mono">
          <div class="d-spec-item"><span class="d-pip"></span> Cloudflare Edge &amp; serverless runtimes</div>
          <div class="d-spec-item"><span class="d-pip"></span> Automated ETL scripts &amp; ETL triggers</div>
          <div class="d-spec-item"><span class="d-pip"></span> Minimal dependency footprint</div>
        </div>
      </div>
      <div class="discipline-foot font-mono">
        <span class="d-target">INFRASTRUCTURE: <strong>LEAN &amp; AUDITED</strong></span>
      </div>
    </div>

    <!-- 04 Direct Principal Access -->
    <div class="discipline-card scroll-view-reveal border-b">
      <div class="discipline-wire" aria-hidden="true"></div>
      <div class="discipline-head font-mono">
        <span class="d-num">[04]</span>
        <span class="d-label">PARTNERSHIP GOVERNANCE</span>
      </div>
      <div class="discipline-body">
        <h3 class="discipline-title">Direct Principal Access</h3>
        <p class="discipline-desc">
          You work directly with the senior engineers, voice squad leads, and data managers executing your requirements. No non-technical account managers playing telephone with 4-day lag.
        </p>
        <div class="discipline-specs font-mono">
          <div class="d-spec-item"><span class="d-pip"></span> Direct access to technical squad leads</div>
          <div class="d-spec-item"><span class="d-pip"></span> Synchronous Slack/Teams channel integration</div>
          <div class="d-spec-item"><span class="d-pip"></span> Multi-year scalability &amp; retention focus</div>
        </div>
      </div>
      <div class="discipline-foot font-mono">
        <span class="d-target">CLIENT RETENTION: <strong>MULTI-YEAR</strong></span>
      </div>
    </div>
  </div>
</section>

<style>
  .approach-section {
    background-color: var(--bg-paper);
    color: var(--text-primary);
    position: relative;
    border-bottom: 1px solid var(--border-paper);
  }

  .approach-intro {
    padding: clamp(40px, 6vw, 72px) var(--grid-pad);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    align-items: end;
    border-bottom: 1px solid var(--border-paper);
  }

  .approach-headline {
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-top: 16px;
  }

  .signal-italic {
    color: var(--accent-signal);
  }

  .approach-subtitle {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 48ch;
  }

  /* 4-Grid Disciplines */
  .disciplines-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .discipline-card {
    background: var(--bg-paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: background-color 0.2s ease;
  }

  .discipline-card:hover {
    background: var(--bg-surface);
  }

  .discipline-card:last-child {
    border-right: none;
  }

  /* Scroll-driven wire on top of card */
  .discipline-wire {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--accent-signal);
    transform-origin: left;
    transform: scaleX(0);
  }

  @supports (animation-timeline: view()) {
    .discipline-wire {
      animation: wire-expand linear both;
      animation-timeline: view();
      animation-range: entry 15% cover 40%;
    }
  }

  .discipline-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border-paper);
    background: rgba(0, 0, 0, 0.02);
  }

  .d-num {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-signal);
  }

  .d-label {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .discipline-body {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .discipline-title {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .discipline-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .discipline-specs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 11px;
    color: var(--text-primary);
    margin-top: auto;
    padding-top: 16px;
  }

  .d-spec-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .d-pip {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--accent-signal);
  }

  .discipline-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-top: 1px solid var(--border-paper);
    background: rgba(0, 0, 0, 0.02);
    font-size: 10px;
    color: var(--text-muted);
  }

  .d-target strong {
    color: var(--accent-signal);
  }

  /* Responsive Matrix */
  @media (max-width: 1120px) {
    .disciplines-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .discipline-card:nth-child(2) {
      border-right: none;
    }
  }

  @media (max-width: 768px) {
    .approach-intro {
      grid-template-columns: 1fr;
    }
    .disciplines-grid {
      grid-template-columns: 1fr;
    }
    .discipline-card {
      border-right: none;
    }
  }
</style>
