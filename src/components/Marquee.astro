      <span class="m-item outline">CONSISTENCY IN DATA <span class="m-sep">&bull;</span></span>
      <span class="m-item outline">GLOBAL SLA STANDARDS <span class="m-sep">&bull;</span></span>
      <span class="m-item outline">DEDICATED TEAMS <span class="m-sep">&bull;</span></span>
      <span class="m-item outline">99.8% PRECISION <span class="m-sep">&bull;</span></span>
    </div>
  </div>
</section>

<style is:global>
  .strip-section {
    padding-block: clamp(24px, 3.8vh, 44px);
    overflow: hidden;
    background: linear-gradient(135deg, var(--tan) 0%, #D9B48F 100%);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    box-shadow: inset 0 2px 14px rgba(0, 0, 0, 0.15);
  }
  .ticker-glow-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.6) 50%, transparent 100%);
  }
  .marquee-track {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 0;
  }
  .marquee-track:hover .marquee-group {
    animation-play-state: paused;
  }
  .marquee-group {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    min-width: 100%;
    animation: scrollTrack 24s linear infinite;
    will-change: transform;
  }
  .marquee-track.reverse .marquee-group {
    animation-direction: reverse;
    animation-duration: 28s;
  }
  .m-item {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font: 800 clamp(1.4rem, 3.2vw, 2.5rem)/1.1 var(--disp);
    letter-spacing: -0.03em;
    padding-inline: 20px;
    white-space: nowrap;
    transition: transform 0.25s ease;
  }
  .m-item:hover {
    transform: scale(1.04);
  }
  .m-badge {
    font-family: monospace;
    font-size: 10.5px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(20, 32, 31, 0.16);
    border: 1px solid rgba(20, 32, 31, 0.25);
    color: var(--ink);
    letter-spacing: 0.08em;
  }
  .m-item.outline {
    color: transparent;
    -webkit-text-stroke: 1.2px var(--ink);
    opacity: 0.9;
  }
  .m-sep {
    font-size: 1.2em;
    opacity: 0.4;
  }

  @keyframes scrollTrack {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-group {
      animation: none;
    }
  }
</style>
