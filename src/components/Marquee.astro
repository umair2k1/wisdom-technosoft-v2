<style>
  .spec-marquee-section {
    position: relative;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
    user-select: none;
    padding: 12px 0;
  }

  .spec-tape {
    width: 100%;
    overflow: hidden;
    display: flex;
  }

  .spec-tape.reverse {
    border-top: 1px solid var(--border);
    margin-top: 8px;
    padding-top: 8px;
  }

  .tape-track {
    display: flex;
    white-space: nowrap;
    width: max-content;
    will-change: transform;
  }

  .tape-cluster {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-right: 16px;
  }

  .axiom-tag {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    padding: 2px 6px;
    background: var(--surface-card);
    border: 1px solid var(--border);
  }

  .axiom-text {
    font-family: var(--disp);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .axiom-outline {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .axiom-sep {
    color: var(--accent);
    font-size: 12px;
    opacity: 0.7;
  }

  /* Continuous fallback translation if CSS scroll timeline not supported */
  @keyframes tape-scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes tape-scroll-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  .tape-track {
    animation: tape-scroll-left 40s linear infinite;
  }
  .spec-tape.reverse .tape-track {
    animation: tape-scroll-right 45s linear infinite;
  }

  @supports (animation-timeline: scroll(root)) {
    .marquee-scroll-fw {
      animation: spec-marquee-forward linear both;
      animation-timeline: scroll(root);
    }
    .marquee-scroll-rev {
      animation: spec-marquee-reverse linear both;
      animation-timeline: scroll(root);
    }
  }
</style>
