      <span class="m-item"><span class="m-badge">VOICE</span> B2B Telecalling Operations <span class="m-sep">&bull;</span></span>
      <span class="m-item"><span class="m-badge">DATA</span> Clean Data Mining &amp; QA <span class="m-sep">&bull;</span></span>
      <span class="m-item"><span class="m-badge">RCM</span> US Medical Billing <span class="m-sep">&bull;</span></span>
      <span class="m-item"><span class="m-badge">BPO</span> Industrial Process Support <span class="m-sep">&bull;</span></span>
      <span class="m-item"><span class="m-badge">HUB</span> Nagpur Delivery Squads <span class="m-sep">&bull;</span></span>
    </div>
  </div>

  <div class="marquee-track reverse" aria-hidden="true">
    <div class="marquee-group">
      <span class="m-item outline">CLARITY IN CODE <span class="m-sep">&bull;</span></span>
      <span class="m-item outline">CARE IN CONVERSATIONS <span class="m-sep">&bull;</span></span>
      <span class="m-item outline">CONSISTENCY IN DATA <span class="m-sep">&bull;</span></span>
