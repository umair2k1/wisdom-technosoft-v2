<style>
  .ticker-section {
    background-color: var(--bg-ink);
    color: var(--text-on-ink);
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid var(--border-ink);
    user-select: none;
  }

  .ticker-track {
    display: flex;
    overflow: hidden;
    padding-block: 14px;
    width: 100%;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.4);
  }

  .ticker-track.reverse .ticker-content {
    animation-direction: reverse;
  }

  .ticker-content {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    flex-shrink: 0;
    will-change: transform;
    animation: ticker-loop 35s linear infinite;
  }

  .ticker-track:hover .ticker-content {
    animation-play-state: paused;
  }

  @keyframes ticker-loop {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  .ticker-item {
    font-size: 11px;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #F4F2EC;
  }

  .badge-acid {
    color: #0B0C0E;
    background-color: var(--accent-acid);
    padding: 2px 5px;
    font-size: 9.5px;
    font-weight: 700;
  }

  .badge-signal {
    color: #FFFFFF;
    background-color: var(--accent-signal);
    padding: 2px 5px;
    font-size: 9.5px;
    font-weight: 700;
  }

  .ticker-truth {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #8A8880;
  }

  .ticker-truth.highlight {
    color: var(--accent-acid);
    font-weight: 700;
  }

  .ticker-sep {
    color: var(--accent-signal);
    opacity: 0.5;
    font-size: 10px;
  }
</style>
